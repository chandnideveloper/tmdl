	measure index =
			VAR _paramVal = LOOKUPVALUE('Parameters'[Value], 'Parameters'[Parameter], "index")
			RETURN IF(ISBLANK(_paramVal), BLANK(), IF(ISNUMBER(VALUE(_paramVal)), VALUE(_paramVal), _paramVal))
			lineageTag: 6435550e-9d7b-5db7-b032-7b00fc9c388d

	measure 'index Value' =
			VAR _sel = SELECTEDVALUE('Parameters'[Value])
			VAR _def = LOOKUPVALUE('Parameters'[Value], 'Parameters'[Parameter], "index")
			VAR _active = COALESCE(_sel, _def)
			RETURN IF(ISBLANK(_active), BLANK(), IF(ISNUMBER(VALUE(_active)), VALUE(_active), _active))
