model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

	annotation PBI_QueryOrder = ["Sales", "Stores", "Products", "_Measures"]
	annotation PBI_ProTooling = ["DevMode"]

ref table Sales
ref table Stores
ref table Products
ref table _Measures

ref cultureInfo en-US
