table APPOINTMENTS
	lineageTag: 69609ee4-5f0e-457e-b187-b562b51fd1ae

	measure 'Doctor Rank' =
			RANKX(
			    ALLSELECTED('APPOINTMENTS'[Doctor Id]),
			    CALCULATE(DISTINCTCOUNT('APPOINTMENTS'[Appointment Id])),
			    ,
			    DESC,
			    DENSE
			)

	measure 'RLS Filter' =
			VAR _DoctorId = SELECTEDVALUE('DOCTOR_ACCESS'[Doctor Id (Doctor Access)])
			VAR _Username = SELECTEDVALUE('DOCTOR_ACCESS'[Username])
			RETURN IF(_DoctorId & "" = "ALL", 1, IF(USERNAME() & "" = _Username & "", 1, 0))

	measure RLS_Filter_WB =
			VAR _DoctorAccessId = SELECTEDVALUE('DOCTOR_ACCESS'[Doctor Id (Doctor Access)])
			RETURN
			IF(
			    _DoctorAccessId & "" = "ALL",
			    1,
			    IF(
			        SELECTEDVALUE('APPOINTMENTS'[Doctor Id]) & "" = _DoctorAccessId & "",
			        1,
			        0
			    )
			)

	measure 'Retention Rate' =
			DIVIDE(
			    SUMX(VALUES('APPOINTMENTS'[Patient Id]), [Returning Patient Flag]),
			    DISTINCTCOUNT('APPOINTMENTS'[Patient Id])
			)

	measure 'CNTD of Appointment Id' = DISTINCTCOUNT('APPOINTMENTS'[Appointment Id])

	measure Appointments = DISTINCTCOUNT('APPOINTMENTS'[Appointment Id])

	measure 'MONTH of Appointment Date' = MONTH('APPOINTMENTS'[Appointment Date])

	measure 'CNTD of Patient Id' = DISTINCTCOUNT('APPOINTMENTS'[Patient Id])

	measure Open_Department_Info_WebPage =
			VAR url1 = "https://en.wikipedia.org/wiki/" & SELECTEDVALUE('APPOINTMENTS'[Department])
			RETURN
			"<iframe src='" & url1 & "' width='100%' height='600'></iframe>"

	measure 'Appointments per Department' = CALCULATE(DISTINCTCOUNT('APPOINTMENTS'[Appointment Id]), ALLEXCEPT('APPOINTMENTS', 'APPOINTMENTS'[Department]))

	measure 'Top N Department Filter' =
			CALCULATE(
			    MINX(
			        VALUES('APPOINTMENTS'[Department]),
			        IF(
			            CALCULATE(COUNT('APPOINTMENTS'[Appointment Id])) >= SELECTEDVALUE('Top N Departments'[Value]),
			            CALCULATE(COUNT('APPOINTMENTS'[Appointment Id])),
			            BLANK()
			        )
			    ),
			    REMOVEFILTERS('APPOINTMENTS')
			)

	measure 'Total Appointments (Fixed)' = CALCULATE(DISTINCTCOUNT('APPOINTMENTS'[Appointment Id]))

	measure 'Total Patients (Fixed)' = CALCULATE(DISTINCTCOUNT('APPOINTMENTS'[Patient Id]))

	measure 'Patient Type' =
			VAR _FirstAppointmentDate =
			CALCULATE(
			    MIN('APPOINTMENTS'[Appointment Date]),
			    ALLEXCEPT('APPOINTMENTS', 'APPOINTMENTS'[Patient Id])
			)
			RETURN
			IF(
			    _FirstAppointmentDate = SELECTEDVALUE('APPOINTMENTS'[Appointment Date]),
			    "New Patient",
			    "Returning Patient"
			)

	measure 'Returning Patient Flag' =
			VAR _PatientAppointmentCount = CALCULATE(DISTINCTCOUNT('APPOINTMENTS'[Appointment Id]), ALLEXCEPT('APPOINTMENTS', 'APPOINTMENTS'[Patient Id]))
			RETURN IF(_PatientAppointmentCount > 1, 1, 0)

	column 'Appointment Id'
		dataType: string
		lineageTag: adbc40c6-d01c-442e-8884-b09cc7ef25e1
		summarizeBy: none
		sourceColumn: Appointment Id

	column 'Patient Id'
