		lineageTag: 6da3d26b-f3c6-4ea5-9552-7880688b24ef
		summarizeBy: none
		sourceColumn: Reason For Visit

	column 'Diagnosis Code'
		dataType: string
		lineageTag: 9c8e34cf-4fdb-4c64-baf2-221200390cff
		summarizeBy: none
		sourceColumn: Diagnosis Code

	column 'Follow Up Required'
		dataType: boolean
		lineageTag: 66c4427e-d99a-4554-b52a-1228c0f43c95
		summarizeBy: none
		sourceColumn: Follow Up Required

	column in_out_Department_Set_Category = IF('APPOINTMENTS'[Department] IN { "Inpatient", "Outpatient" }, "In", "Out")
		dataType: string
		summarizeBy: none

	column 'Department Focus' = IF('APPOINTMENTS'[in_out_Department_Set_Category] = "In", "Selected", "Other")
		dataType: string
		summarizeBy: none

	column 'Day of Week' = FORMAT('APPOINTMENTS'[Appointment Date], "dddd")
		dataType: string
		summarizeBy: none

	partition APPOINTMENTS = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases("zldagwo-pw94760.snowflakecomputing.com", "COMPUTE_WH"),
				    DB = Source{[Name="CITY_HOSPITAL"]}[Data],
				    Schema = DB{[Name="PUBLIC"]}[Data],
				    Table = Schema{[Name="APPOINTMENTS"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(Table, {{"APPOINTMENT_ID", type text}, {"PATIENT_ID", type text}, {"DOCTOR_ID", type text}, {"DEPARTMENT", type text}, {"APPOINTMENT_DATE", type date}, {"APPOINTMENT_TIME", type datetime}, {"VISIT_STATUS", type text}, {"REASON_FOR_VISIT", type text}, {"DIAGNOSIS_CODE", type text}, {"FOLLOW_UP_REQUIRED", type logical}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type", {{"APPOINTMENT_ID", "Appointment Id"}, {"PATIENT_ID", "Patient Id"}, {"DOCTOR_ID", "Doctor Id"}, {"DEPARTMENT", "Department"}, {"APPOINTMENT_DATE", "Appointment Date"}, {"APPOINTMENT_TIME", "Appointment Time"}, {"VISIT_STATUS", "Visit Status"}, {"REASON_FOR_VISIT", "Reason For Visit"}, {"DIAGNOSIS_CODE", "Diagnosis Code"}, {"FOLLOW_UP_REQUIRED", "Follow Up Required"}})
				in
				    #"Renamed Columns"

