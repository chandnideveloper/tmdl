	column 'Appointment Date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: f3b1d7eb-939d-4962-905f-6fffe67a4c9a
		summarizeBy: none
		sourceColumn: Appointment Date

		variation Variation
			isDefault
			relationship: dd2161af-066e-4304-a9da-5f8e31ea5abf
			defaultHierarchy: LocalDateTable_1ada9aa9-b707-4bb1-93be-cf47de475437.'Date Hierarchy'

		changedProperty = DataType

		annotation UnderlyingDateTimeDataType = Date

	column 'Appointment Time'
		dataType: dateTime
		formatString: General Date
		lineageTag: 45a3713f-9d4c-41fe-bbb8-d2cc9deb5776
		summarizeBy: none
		sourceColumn: Appointment Time

		variation Variation
			isDefault
			relationship: 6c715226-17f4-49c8-8ad2-ab69b1a5df7f
			defaultHierarchy: LocalDateTable_a7a1b85e-6386-4d11-bb7d-c72d32f3939f.'Date Hierarchy'

		changedProperty = DataType

		annotation UnderlyingDateTimeDataType = Date

	column 'Visit Status'
		dataType: string
		lineageTag: 76d0d595-b4a2-4a0a-90d9-bb353a15b1e9
		summarizeBy: none
		sourceColumn: Visit Status

	column 'Reason For Visit'
