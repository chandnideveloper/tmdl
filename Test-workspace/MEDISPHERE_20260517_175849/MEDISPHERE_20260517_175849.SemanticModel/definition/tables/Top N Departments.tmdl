table 'Top N Departments'

	measure SelectedTopNDepartments = SELECTEDVALUE('Top N Departments'[Value], 0)
		formatString: 0
		isHidden

	column Value
		isNameInferred
		sourceColumn: [Value]

	partition 'Top N Departments' = calculated
		mode: import
		source = DATATABLE("Value", INTEGER, {{1}, {2}, {3}, {4}, {5}})

	annotation PBI_Id = 92b74f7bab9e48c8ae7c2ace90f05336

