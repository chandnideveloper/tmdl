	partition DeliveryEvents = m
		mode: import
		source =
				let
				    Source = AmazonRedshift.Database("fleetvision-wg.881226714470.ap-southeast-2.redshift-serverless.amazonaws.com:5439", "dev"),
				    Result = Value.NativeQuery(Source, "SELECT
				        event_id,
				        trip_id,
				        event_type,
				        facility_id,
				        scheduled_datetime,
				        actual_datetime,
				        detention_minutes,
				        on_time_flag,
				        location_city     AS delivery_city,
				        location_state    AS delivery_state
				        FROM fleetvision.delivery_events", null, [EnableFolding=false])
				in
				    Result

	annotation PBI_ResultType = Table

