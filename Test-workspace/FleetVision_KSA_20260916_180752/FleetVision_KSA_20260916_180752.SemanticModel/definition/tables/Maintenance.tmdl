	partition Maintenance = m
		mode: import
		source =
				let
				    Source = AmazonRedshift.Database("fleetvision-wg.881226714470.ap-southeast-2.redshift-serverless.amazonaws.com:5439", "dev"),
				    Result = Value.NativeQuery(Source, "SELECT
				        maintenance_id,
				        truck_id,
				        maintenance_date,
				        maintenance_type,
				        odometer_reading,
				        labor_hours,
				        labor_cost,
				        parts_cost,
				        total_cost        AS maintenance_total_cost,
				        facility_location,
				        downtime_hours,
				        service_description
				        FROM fleetvision.maintenance_records", null, [EnableFolding=false])
				in
