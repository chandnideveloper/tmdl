table _Measures
	lineageTag: 7724e053-781a-51b9-b665-e9ad6750f4b4

	measure 'Total Revenue' = DIVIDE(SUM('Loads'[revenue]), 1000000, 0)
		lineageTag: 91098b09-6315-5012-8cb4-76e719439999

	measure 'Customer Analytics' = MAXX(SUMMARIZE('Loads', 'Customers'[customer_name], "@value", SUM('Loads'[revenue])), [@value])
		lineageTag: 5a444008-2977-58aa-8afd-9a301f70d1f2

	measure 'Maximum Trips by Truck' = MAXX(SUMMARIZE('Trips', 'Trips'[truck_id], "@value", COUNT('Trips'[trip_id])), [@value])
		lineageTag: 8dbb9c27-3953-55a5-b794-ee73660ad1b0

	measure 'Highest Revenue by Customer' = MAXX(SUMMARIZE('Loads', 'Customers'[customer_name], "@value", SUM('Loads'[revenue])), [@value])
		lineageTag: 1b63a406-2922-5cb0-9dcf-d471af1453d0

	measure 'Average Trip Distance' = AVERAGE('Trips'[actual_distance_miles])
		lineageTag: e35b7be9-e127-541f-ad6a-bc4af4bb08cc

	measure 'Active Trailers' = CALCULATE(DISTINCTCOUNT('Trips'[trailer_id]), 'Trailers'[trailer_status] = "Active")
		lineageTag: efd511ba-959e-5b93-8c68-f84eb5915b8d

	measure 'Average Revenue per Load' = AVERAGE('Loads'[revenue])
		lineageTag: ec7cf70c-2291-5cbb-9d68-2b9728cb6e1a

	measure 'High Value Revenue' = CALCULATE(SUM('Loads'[revenue]), 'Loads'[RevenueBand] = "High Value")
		lineageTag: 9e0aa5db-e86e-5f58-b721-d6dbdd9858ce

	measure 'Average Trip Duration' = AVERAGE('Trips'[actual_duration_hours])
		lineageTag: 02209d34-c0d5-5a0b-b601-dbd7d263f297

	measure 'Total Trips' = COUNT('Trips'[trip_id])
		lineageTag: ea0647f4-bb8e-5695-81ab-ea36102811b3

	measure 'Average Revenue per Customer' = DIVIDE(SUM('Loads'[revenue]), DISTINCTCOUNT('Customers'[customer_id]), 0)
		lineageTag: 290c931b-09a5-5f54-b1d3-6d67170e6f7f

	measure 'Total Drivers' = DISTINCTCOUNT('Trips'[driver_id])
		lineageTag: 68a17c3b-ad04-50fc-b2ce-020ad3d1aa60

	measure 'Driver Analytics' = AVERAGEX(SUMMARIZE('Loads', 'Trips'[driver_id], "@value", SUM('Loads'[revenue])), [@value])
		lineageTag: e05a035d-85ce-5856-a036-1afbc7f0beb3

	measure 'High Value Revenue %' = DIVIDE(CALCULATE(SUM('Loads'[revenue]), 'Loads'[RevenueBand] = "High Value"), SUM('Loads'[revenue]), 0)
		lineageTag: d15eab55-18f2-558a-b3d8-3f6bde57dfa6

	measure 'Revenue per Mile' = DIVIDE(SUM('Loads'[revenue]), SUM('Trips'[actual_distance_miles]), 0)
		lineageTag: 6a7f8c9d-ae59-5350-b000-d2098e25e5dd

	measure 'Revenue per Trip' = DIVIDE(SUM('Loads'[revenue]), COUNT('Trips'[trip_id]), 0)
		lineageTag: be478467-bb36-5135-92b2-1280a432b523

	measure 'Completed Trips' = CALCULATE(COUNT('Trips'[trip_id]), 'Trips'[trip_status] = "Completed")
		lineageTag: d2d76ee4-575e-578f-bce6-66873c2a5729

	measure 'Average Revenue per Driver' = AVERAGEX(SUMMARIZE('Loads', 'Trips'[driver_id], "@value", SUM('Loads'[revenue])), [@value])
		lineageTag: b48816ec-1244-5c22-ae05-174fd572bc6d

	measure 'Completed Trip Revenue' = CALCULATE(SUM('Loads'[revenue]), 'Trips'[trip_status] = "Completed")
		lineageTag: 86eaa52e-08bb-55ec-abcb-003200199e96

	measure 'Active Trucks' = CALCULATE(DISTINCTCOUNT('Trips'[truck_id]), 'Trucks'[truck_status] = "Active")
		lineageTag: c15447ed-173b-597c-9fbd-28e01a6288cc

	measure 'Average Fuel Efficiency' = DIVIDE(SUM('Trips'[actual_distance_miles]), SUM('Trips'[fuel_gallons_used]), 0)
		lineageTag: e65eef8f-660c-5c9d-a653-c6f0286b46d3

	measure 'High Value Loads' = CALCULATE(DISTINCTCOUNT('Trips'[load_id]), 'Loads'[RevenueBand] = "High Value")
		lineageTag: 941ed71d-c9cd-5bf8-9c14-71585bf98f31

	measure 'Fleet Operations' = MAXX(SUMMARIZE('Trips', 'Trips'[truck_id], "@value", COUNT('Trips'[trip_id])), [@value])
		lineageTag: 2ef29338-e4c0-5eed-a44e-0f4e6a6cc9aa

	measure 'Revenue %' = DIVIDE(SUM('Loads'[revenue]), CALCULATE(SUM('Loads'[revenue]), ALLSELECTED()), 0)
		lineageTag: f72e061a-527b-5da5-a953-892acb27092f

	measure 'On-Time Delivery %' = AVERAGE('DeliveryEvents'[on_time_flag])*100
		lineageTag: fae51d1f-d8f9-5b55-99bd-a56967d5ec3d

	measure 'Total Loads' = COUNT('Trips'[load_id])
		lineageTag: dc568f16-f764-5701-bf95-6f1a21fe4d5b

	measure 'Total Customers' = DISTINCTCOUNT('Customers'[customer_id])
		lineageTag: 0902181d-1af0-50ef-8642-3b06b993e9f3

	measure 'Total Maintainane Cost' = SUM('Maintenance'[maintenance_total_cost])
		lineageTag: 77f41ac7-0c8c-5611-814a-bcf9899d6369

	measure 'Diesel Trucks' = CALCULATE(DISTINCTCOUNT('Trips'[truck_id]), 'Trucks'[fuel_type] = "Diesel")
		lineageTag: f6f5cf4a-1ce0-556e-8a42-57c0aa05be76

	measure 'Fleet Size' = DISTINCTCOUNT('Trips'[truck_id])
		lineageTag: 15746ebf-8cf3-5cb4-aa70-041d190332e4

	measure 'Total Revenue Trips' = DIVIDE(SUM('Loads'[revenue]), 1000000, 0)
		lineageTag: f7d01dcf-3507-5017-a4e6-e11c2c850871

	measure Avg(idle_time_hours) = AVERAGE('Trips'[idle_time_hours])
		lineageTag: 006dce75-05d3-57ff-9787-b106c34baf73

	measure Avg(actual_distance_miles) = AVERAGE('Trips'[actual_distance_miles])
		lineageTag: 5a97047a-bc4b-53e2-a3ee-96e38586420e

	measure Avg(average_mpg) = AVERAGE('Trips'[average_mpg])
		lineageTag: 7441cc14-eea6-5581-9600-a9ba5b5c9101

	column _placeholder
