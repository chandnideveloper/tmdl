	partition Trucks = m
		mode: import
		source =
				let
				    Source = AmazonRedshift.Database("fleetvision-wg.881226714470.ap-southeast-2.redshift-serverless.amazonaws.com:5439", "dev"),
				    Result = Value.NativeQuery(Source, "SELECT
				        truck_id,
				        unit_number,
				        make,
				        model_year            AS truck_model_year,
				        vin                   AS truck_vin,
				        acquisition_date      AS truck_acquisition_date,
				        acquisition_mileage,
				        fuel_type,
				        tank_capacity_gallons,
				        status                AS truck_status,
				        home_terminal         AS truck_home_terminal
				        FROM fleetvision.trucks", null, [EnableFolding=false])
				in
				    Result

