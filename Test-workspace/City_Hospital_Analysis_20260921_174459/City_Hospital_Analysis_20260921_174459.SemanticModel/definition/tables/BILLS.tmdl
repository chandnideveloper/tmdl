		formatString: "#,##0.00"
		lineageTag: 5d6d6782-8535-5210-ab25-579045cb9989

	measure 'Insurance Coverage %' = DIVIDE(SUM('BILLS'[INSURANCE_COVERED]), SUM('BILLS'[TOTAL_AMOUNT]), 0)
