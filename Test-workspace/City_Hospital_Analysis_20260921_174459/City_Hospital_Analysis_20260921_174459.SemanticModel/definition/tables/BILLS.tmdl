table BILLS
	lineageTag: ad28a9f2-8e4a-5ba5-b044-0c2a2cfca269

	measure 'Total Revenue' = SUM('BILLS'[TOTAL_AMOUNT])
		formatString: "#,##0.00"
		lineageTag: 91098b09-6315-5012-8cb4-76e719439999

	measure 'Total Billing Amount' = SUM('BILLS'[TOTAL_AMOUNT])
		formatString: "#,##0.00"
		lineageTag: ef30ae6c-07ab-5b7b-b1cc-c1bfe5703b5d

