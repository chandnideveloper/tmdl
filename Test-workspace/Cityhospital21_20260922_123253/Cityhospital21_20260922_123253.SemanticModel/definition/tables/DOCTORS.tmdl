    column 'Specialization'
        dataType: string
        lineageTag: de11b425-eb09-49ca-85a1-55a98a5a8822
        summarizeBy: none
        sourceColumn: Specialization

    column 'Department (Doctors)'
        dataType: string
        lineageTag: 0fa44b68-f04d-42e2-9142-0d40c6e79454
        summarizeBy: none
        sourceColumn: Department (Doctors)

    column 'Contact Number'
        dataType: string
        lineageTag: a081c85e-b80b-4c1a-a249-498d02dea294
        summarizeBy: none
        sourceColumn: Contact Number

    column 'Email Address'
        dataType: string
        lineageTag: fc01826d-a318-4bad-974d-a275c1050d36
        summarizeBy: none
