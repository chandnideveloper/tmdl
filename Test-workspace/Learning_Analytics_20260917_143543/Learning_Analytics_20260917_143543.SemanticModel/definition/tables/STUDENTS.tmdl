table STUDENTS
	lineageTag: d1a3acd2-4342-56b0-b44b-b3185bf3bfbe

	measure 'Total Students' = COUNT('STUDENT_COURSES'[STUDENT_ID])
		formatString: #,##0.00
		lineageTag: c19b17d3-ba7e-5a82-ae8a-5c0d746fc86f

	column Age = DATEDIFF('STUDENTS'[DOB], TODAY(), YEAR)
		dataType: double
		lineageTag: a89ef938-4bc2-583a-a8e3-e461041a0043
		summarizeBy: none

	column STUDENT_ID
		dataType: string
		lineageTag: e6072bd5-a33f-5ce6-9f08-8e52fd1a0c8d
		summarizeBy: none
		sourceColumn: STUDENT_ID

		annotation SummarizationSetBy = Automatic

	column GENDER
		dataType: string
		lineageTag: c94a06a9-75f3-5bec-a8b2-b8e5d8c2d87e
		summarizeBy: none
		sourceColumn: GENDER

		annotation SummarizationSetBy = Automatic

	column DOB
		dataType: string
		lineageTag: dfefa085-5358-5930-9edb-6f23d11cf12d
		summarizeBy: none
		sourceColumn: DOB

		annotation SummarizationSetBy = Automatic

	column STUDENTS_FIRST_NAME
		dataType: string
		lineageTag: 3d6c9f50-f65e-4a99-8061-ac6d92b682b9
		summarizeBy: none
		sourceColumn: STUDENTS_FIRST_NAME

		annotation SummarizationSetBy = Automatic

	column STUDENTS_LAST_NAME
		dataType: string
		lineageTag: e17699e3-0468-4a88-b8e9-c97352312f9c
		summarizeBy: none
		sourceColumn: STUDENTS_LAST_NAME

		annotation SummarizationSetBy = Automatic

	column STUDENTS_EMAIL
		dataType: string
		lineageTag: c7e0ca26-a572-4531-8b99-72fc826228a9
		summarizeBy: none
		sourceColumn: STUDENTS_EMAIL

		annotation SummarizationSetBy = Automatic

	partition STUDENTS = m
		mode: import
		source =
				let
				    Source = #table({"STUDENT_ID", "STUDENTS_FIRST_NAME", "STUDENTS_LAST_NAME", "GENDER", "DOB", "STUDENTS_EMAIL"}, {})
				in
				    Source

	annotation PBI_ResultType = Table

