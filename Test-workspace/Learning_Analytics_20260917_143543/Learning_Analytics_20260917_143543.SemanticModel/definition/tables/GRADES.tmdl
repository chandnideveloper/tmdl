	column GRADE
		dataType: string
		lineageTag: 4dc4d5de-406d-50ce-b1a8-6cea8fe04ef4
		summarizeBy: none
		sourceColumn: GRADE

		annotation SummarizationSetBy = Automatic

	column GRADED_DATE
		dataType: string
		lineageTag: 2cce7886-b84c-54df-be81-02188581e667
		summarizeBy: none
		sourceColumn: GRADED_DATE

		annotation SummarizationSetBy = Automatic

	partition GRADES = m
		mode: import
		source =
				let
				    Source = #table({"GRADE_ID", "ENROLLMENT_ID", "GRADE", "GRADED_DATE"}, {})
				in
				    Source

	annotation PBI_ResultType = Table

