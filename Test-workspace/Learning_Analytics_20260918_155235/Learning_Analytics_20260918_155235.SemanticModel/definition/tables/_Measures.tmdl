table _Measures
	lineageTag: 7724e053-781a-51b9-b665-e9ad6750f4b4

	/// TODO (Qlik $() dollar expansion has no direct DAX equivalent): Convert the Qlik expression to DAX manually.
	/// Original Qlik: CALCULATE(SUM([1]), [Date] >= $(=AddMonths(MonthStart($(vMaxLoaded)),-11))<=$(=MonthEnd($(vMaxLoaded))), CALCULATE(Date=ASSIGNED_DATE_DATE))
	measure 'Rolling 12-month assignments' = BLANK()
		formatString: "#,##0.00"
		lineageTag: 088d1460-22c9-5ca7-94d3-dffceeafe409

	column _placeholder
		dataType: string
		isHidden
		lineageTag: da4619db-a22e-548c-945a-314c8c5ff5f9
		summarizeBy: none
		sourceColumn: _placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows({}, {"_placeholder"})
				in
				    Source
