table 'Revenue Threshold'

    column 'Value'
        formatString: 0
        summarizeBy: sum
        isNameInferred
        sourceColumn: 'Revenue Threshold'[Value]
        annotation SummarizationSetBy = Automatic

    partition 'Revenue Threshold' = calculated
        mode: import
        source = GENERATESERIES(0, 100000, 1)

    measure 'SelectedRevenueThreshold'
        expression: SELECTEDVALUE('Revenue Threshold'[Value], 0)
        formatString: 0
        isHidden: true

    annotation PBI_Id = 97b9bd0ffece4d0aa698af5ebfd6e688
    