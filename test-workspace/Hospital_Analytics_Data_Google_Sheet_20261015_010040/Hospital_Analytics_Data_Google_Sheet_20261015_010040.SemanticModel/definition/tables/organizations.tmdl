    column 'Name'
        dataType: string
        lineageTag: 2e9b6553-31c6-4858-9fd9-54fb4c3e3164
        summarizeBy: none
        sourceColumn: Name

    column 'ADDRESS'
        dataType: string
        lineageTag: d1f63513-6825-4d8b-ae33-3ea898cf3dc2
        summarizeBy: none
        sourceColumn: ADDRESS

    column 'CITY'
        dataType: string
        lineageTag: d46db76d-bef6-48ca-9498-9703e37dab3e
