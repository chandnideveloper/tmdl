table organizations
	lineageTag: f6205821-66e3-42d1-a5a7-cd7199ba7aa6

	measure 'Visits % Contribution (LOD)' = BLANK()
		lineageTag: 9155873a-daf4-4807-92ed-83a9d001fa7b

	measure 'Total Patients (LOD)' = CALCULATE(DISTINCTCOUNT('patients'[Id]), ALL('patients'))
		lineageTag: a20eb232-0dd5-4dc6-8905-2e50ba181fa1

	measure 'Total Procedures (LOD)' = CALCULATE(COUNT('encounters'[Code]), ALL('encounters'))
		lineageTag: f2b237fb-8f72-46c5-aad7-b85f7cc0b413

	measure 'Total Visits (LOD)' = CALCULATE(COUNT('organizations'[Id]), ALL('organizations'))
		lineageTag: be41e59d-65fe-42c3-a5d2-8048ac0e655b

	measure 'Visits per Patient' = CALCULATE(COUNT('organizations'[Id]), ALLEXCEPT('patients', 'patients'[Id]))
		lineageTag: fae4c589-c15c-48aa-a202-de7fe8bd0dcd

	measure 'Avg Visits per Patient' = CALCULATE(AVERAGE('patients'[Visits per Patient]), ALLEXCEPT('patients', 'patients'[Gender]))
		lineageTag: 72ea5beb-f0aa-4b24-b0fb-ae9891ba0212

	measure 'SUM of Visits per Patient' = SUM('organizations'[Visits per Patient])
		lineageTag: bd4ba681-909e-4dba-bbac-ce8758d4d911

	measure 'RLS - Organization Access' = BLANK()
		lineageTag: 97c825ee-db0a-4e7d-9e39-b6f31df27649

