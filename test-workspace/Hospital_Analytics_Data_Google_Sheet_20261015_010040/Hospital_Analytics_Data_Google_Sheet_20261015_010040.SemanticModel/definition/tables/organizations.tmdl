        sourceColumn: STATE

    column 'ZIP'
        dataType: double
        lineageTag: 94702aef-931e-465e-95e4-3e1e511f70c1
        summarizeBy: none
        sourceColumn: ZIP

    column 'LAT'
        dataType: double
        lineageTag: 630e72d0-5fa3-43fe-b6d4-9bbd3357df0d
