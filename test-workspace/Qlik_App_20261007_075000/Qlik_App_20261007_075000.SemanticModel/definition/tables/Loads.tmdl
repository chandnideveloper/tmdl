table Loads
	lineageTag: 13e30a87-fa1f-5fb1-a4d4-f18fb28b9558

	measure 'Total Revenue' = ROUND(DIVIDE(SUM('Loads'[revenue]), 1000000, BLANK()), 1)
		formatString: "\$#,##0.0\M"
		lineageTag: 91098b09-6315-5012-8cb4-76e719439999

	measure 'Average Revenue per Load' = AVERAGE('Loads'[revenue])
		lineageTag: ec7cf70c-2291-5cbb-9d68-2b9728cb6e1a

	measure 'High Value Revenue %' = DIVIDE(CALCULATE(SUM('Loads'[RevenueBand]), 'Loads'[RevenueBand] = "High Value"), Sum('Loads'[revenue]), BLANK())
		formatString: "0.0%"
		lineageTag: d15eab55-18f2-558a-b3d8-3f6bde57dfa6

	measure 'High Value Loads' = CALCULATE(DISTINCTCOUNT('Loads'[load_id]), 'Loads'[RevenueBand] = "High Value")
		lineageTag: 941ed71d-c9cd-5bf8-9c14-71585bf98f31

	measure 'Revenue %' = DIVIDE(Sum('Loads'[revenue]), CALCULATE(SUM('Loads'[revenue]), ALLSELECTED()), BLANK())
		formatString: "0.0%"
		lineageTag: f72e061a-527b-5da5-a953-892acb27092f

	measure 'Total Loads' = COUNT('Loads'[load_id])
		lineageTag: dc568f16-f764-5701-bf95-6f1a21fe4d5b

