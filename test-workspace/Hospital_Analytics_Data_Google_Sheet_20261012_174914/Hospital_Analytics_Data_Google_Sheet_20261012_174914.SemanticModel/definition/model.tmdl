ref table 'LocalDateTable_7dc91c20-9456-48c7-8fcd-985c56489967'

ref cultureInfo en-US

relationship 2befb524-e4da-4b1f-8334-f47018debf4f
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id (organizations)'
    crossFilteringBehavior: bothDirections

relationship a1691416-265b-4b1d-892c-13595181f54c
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id (patients)'
    crossFilteringBehavior: bothDirections

relationship 2c22d0a5-17e7-4baa-8e9c-5c481b30805b
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id (payers)'
    crossFilteringBehavior: bothDirections

relationship 60075577-a96d-4079-b3f9-d8201d9dc2c1
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship f7e750e9-7145-4b87-aae7-3849f6c94037
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_27ea3619-c026-4e1e-9ac0-1cd5b84b1fbb'.'Date'
