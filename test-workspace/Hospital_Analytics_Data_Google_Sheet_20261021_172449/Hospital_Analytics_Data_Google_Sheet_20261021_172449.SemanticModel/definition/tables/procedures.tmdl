        dataType: string
        lineageTag: 2371f9bc-6980-44b6-b267-d4aea60860be
        summarizeBy: none

    column 'DESCRIPTION__procedures__Set' = 'procedures'[DESCRIPTION__procedures__Set_Category]
        dataType: string
        lineageTag: ad2ee180-31df-498b-9a2b-63f467cf610d
        summarizeBy: none

    column 'DESCRIPTION (procedures) Set' = IF('procedures'[DESCRIPTION] IN { "Admission to burn unit", "Admission to long stay hospital", "Admission to orthopedic department", "Admission to trauma surgery department", "Ankle X-ray", "Antenatal RhD antibody screening", "Assessment of health and social care needs (procedure)" }, "In", "Out")
        dataType: string
        lineageTag: 4d2d8738-53bc-45cb-a5ab-d57f773d27b7
        summarizeBy: none

    measure 'Procedure Rank(Top N Procedure Parameter)' =
        RANKX(ALLSELECTED('procedures'), CALCULATE(COUNT('procedures'[CODE])), , DESC, DENSE)


    measure 'Top N Procedures Filter' =
        IF([Procedure Rank(Top N Procedure Parameter)] <= SELECTEDVALUE('Top N Procedures(Parameter)'[Value]), 1, 0)


    measure 'Total Procedures' =
        COUNT('procedures'[CODE])


    measure 'Procedures Measure' =
        COUNT('procedures'[CODE])


    partition 'procedures' = m
        mode: import
        source =
            let Source = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/10X1xQHkGidpz_0qYh7o9mxmsRJsOHRB9bNnSKFnUNgo"),
