model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_0de126be-78da-48db-88c4-9853809787bc'
ref table 'LocalDateTable_123a6c3f-b9af-4b55-b49c-351e48def832'
ref table 'LocalDateTable_e888a8c0-797a-4048-85d6-f9d95c7e7103'

ref cultureInfo en-US

relationship 238b265b-0c15-4d21-aa6e-ca86e1475de8
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship 375fbffb-cebf-4bb7-8a1e-6bf8527576cd
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship 88efa962-8ea2-4123-aa70-2250233fa702
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship 1e9de081-0dea-422a-a16c-14ab9c0b014b
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 5f65921b-630f-4c81-ab8b-4efe2b768bd7
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_0de126be-78da-48db-88c4-9853809787bc'.'Date'
    joinOnDateBehavior: datePartOnly

relationship b2a9cfe0-caae-41b1-9619-bcc886e5a7c7
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_123a6c3f-b9af-4b55-b49c-351e48def832'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 5f5a54d1-3e78-4ca2-a80a-3cee0f3b3316
