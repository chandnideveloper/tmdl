table organizations
	lineageTag: 49eea7ee-9a68-4672-8694-1087a1ddbf58

	measure 'Visits % Contribution (LOD)' = DIVIDE(DISTINCTCOUNT('organizations'[Id]), CALCULATE([Total Visits (LOD)], ALLSELECTED()))
		lineageTag: 0deb28f3-1e42-4749-82dc-da4808fbadeb

	measure 'Total Patients (LOD)' = CALCULATE(DISTINCTCOUNT('patients'[Id]), ALL('patients'))
		lineageTag: 25ea56c4-a68e-4edd-b162-057fd0422df4

	measure 'Total Procedures (LOD)' = CALCULATE(COUNT('encounters'[Code]), ALL('encounters'))
		lineageTag: 0f914490-1735-4baa-b237-793a8ce66e3c

	measure 'Total Visits (LOD)' = CALCULATE(COUNT('organizations'[Id]), ALL('organizations'))
		lineageTag: 24056780-8fe4-4703-b78a-e0109855c84d

	measure 'Visits per Patient' = CALCULATE(COUNT('organizations'[Id]), ALLEXCEPT('patients', 'patients'[Id]))
		lineageTag: 449f16df-5ff5-4baf-adec-4694435bb7a7

	measure 'Avg Visits per Patient' = CALCULATE(AVERAGE('patients'[Visits per Patient]), ALLEXCEPT('patients', 'patients'[Gender]))
		lineageTag: 2e40956c-1ae4-45a5-a5fe-83adac7786a3

	measure 'SUM of Visits per Patient' = SUM('organizations'[Visits per Patient])
		lineageTag: 3233b696-fe4e-4f65-835e-4a9a7d249835

	measure 'RLS - Organization Access' = IF(USERNAME() = "akash020102@gmail.com", TRUE(), SELECTEDVALUE('organizations'[Name]) = "MASSACHUSETTS GENERAL HOSPITAL")
		lineageTag: 1e8ffca9-5c88-4f69-af11-573bcf9c4cba

