model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_02213c82-5bb9-49c6-935b-fc52483d6fb9'
ref table 'LocalDateTable_efc6fa47-c300-4814-89fe-ab32b8e38875'
ref table 'LocalDateTable_65435b02-1c4f-4d4e-9885-4caf734f18cb'

ref cultureInfo en-US

relationship dbc1f34f-cafe-48bd-a61c-13edb7f207bf
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship 1040670b-d443-433f-bfd3-7f3f042b5f70
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship 0aab1dd5-ffdd-43ae-a199-c1bab4856f33
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship becb4cd9-5809-4439-85cd-885b7308a7f5
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship a341c13a-99b5-494b-b504-aa0fbdfa2087
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_02213c82-5bb9-49c6-935b-fc52483d6fb9'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 190b4883-033b-4948-8091-8239c8d564bb
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_efc6fa47-c300-4814-89fe-ab32b8e38875'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 717b5341-5a6b-42ec-8c59-785faa6c8b19
    fromColumn: 'procedures'.'Encounter Start Date'
    toColumn: 'LocalDateTable_65435b02-1c4f-4d4e-9885-4caf734f18cb'.'Date'
