model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'encounters'
ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_e3c3bd0a-11b4-471d-bd74-22efbd10e8db'
ref table 'LocalDateTable_e12177d2-606e-48ec-8a11-fd16bc6ccde7'
ref table 'LocalDateTable_47c1db65-b760-40b5-b9cf-9a81158cd43f'

ref cultureInfo en-US

relationship 7b1b1628-71d9-4bb9-8ed9-3ab7f070f35e
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id (organizations)'
    crossFilteringBehavior: bothDirections

relationship e82af5f1-543a-4340-86d9-2ba731308b15
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id (patients)'
    crossFilteringBehavior: bothDirections

relationship 4a0f52cf-207c-4e21-b424-0c7a794ecad0
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id (payers)'
    crossFilteringBehavior: bothDirections

relationship 50a39477-068d-48e5-a3d6-0f469e50002a
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship a0076e55-5570-4db5-a836-b4765e6463f2
    fromColumn: 'encounters'.'Encounter Start Date'
    toColumn: 'LocalDateTable_e3c3bd0a-11b4-471d-bd74-22efbd10e8db'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 4eac1f4f-55bc-418d-babd-ceb7d15aa488
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_e12177d2-606e-48ec-8a11-fd16bc6ccde7'.'Date'
    joinOnDateBehavior: datePartOnly

relationship b099bf61-43bc-400e-ba34-1bad90ae1876
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_47c1db65-b760-40b5-b9cf-9a81158cd43f'.'Date'
