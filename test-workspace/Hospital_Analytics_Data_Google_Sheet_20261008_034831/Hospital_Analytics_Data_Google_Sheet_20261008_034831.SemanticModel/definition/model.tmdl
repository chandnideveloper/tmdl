ref table 'LocalDateTable_2c809ccf-82f8-48af-b497-b0b68e0f66e4'
ref table 'LocalDateTable_14461af3-76f7-4a8b-9b17-91012db716fe'

ref cultureInfo en-US

relationship c0edb827-128d-48bf-a1af-a09db96239d8
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id (organizations)'
    crossFilteringBehavior: bothDirections

relationship 2355c7fe-6161-491f-b20f-7eba4c6447c5
