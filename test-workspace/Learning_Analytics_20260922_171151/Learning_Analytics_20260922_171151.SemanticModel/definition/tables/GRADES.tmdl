	partition GRADES = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases("gq37595.ap-southeast-7.aws.snowflakecomputing.com", "COMPUTE_WH"),
				    Db = Source{[Name="LEARNING_ANALYTICS",Kind="Database"]}[Data],
				    Result = Value.NativeQuery(Db, "SELECT ""GRADE_ID"", ""ENROLLMENT_ID"", ""GRADE"", ""GRADED_DATE"" FROM ""LEARNING_ANALYTICS"".""PUBLIC"".""GRADES""", null, [EnableFolding=false]),
				    #"Changed Type" = Table.TransformColumnTypes(Result, {{"GRADE_ID", type text}, {"ENROLLMENT_ID", type text}, {"GRADE", type text}, {"GRADED_DATE", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table