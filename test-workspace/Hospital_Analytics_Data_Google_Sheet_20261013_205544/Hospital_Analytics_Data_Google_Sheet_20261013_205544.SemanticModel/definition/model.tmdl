model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_5a699a5b-1a98-438a-aa7f-cac2b8616304'
ref table 'LocalDateTable_a0bbd175-7377-48e8-a26b-efcbc5341e8b'
ref table 'LocalDateTable_1a30940c-bb70-4cab-bf9a-1f8578106043'

ref cultureInfo en-US

relationship 803f67c4-b674-444c-a36e-38f5739ef876
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship 11cafb0f-9eb3-4bce-8780-b69e270d1853
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship f8988248-ae71-45df-8686-a8d5af889f2b
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship 14dfcf3a-0afa-46c3-9719-8c42ce1bfc6d
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship e4d4bf7a-fea3-4a7d-8987-42536282badc
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_5a699a5b-1a98-438a-aa7f-cac2b8616304'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 99e8e2a9-5214-4562-a08e-2b2c985a7d58
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_a0bbd175-7377-48e8-a26b-efcbc5341e8b'.'Date'
