table encounters
	lineageTag: 457e23b4-0b24-4aaf-991b-c6503c9a5bc7

	measure 'CNT of Id (encounters)' = COUNT('encounters'[Id])
		lineageTag: ffff743f-c614-47cb-92df-fb7c737b2dd3

	measure 'Total Visits' = COUNT('encounters'[Id])
		lineageTag: 6d6f24e3-65ca-4c49-a322-7b285a06b657

	measure 'SUM of Visits per Patient (encounters)' = SUM('encounters'[Visits per Patient])
		lineageTag: 608cc1ff-9570-446a-b182-82b5fd36a712

	measure 'SUM of Base Encounter Cost (encounters)' = SUM('encounters'[Base Encounter Cost])
		lineageTag: fd70a0c1-0f5e-4dce-a3b2-98ff8d50d4c6

	measure 'Total Visits (LOD)' = CALCULATE(COUNT('encounters'[Id]), ALLSELECTED())
		lineageTag: a200cdeb-b630-4e5e-bd6f-f9b6fed7e633

	measure 'Visits per Patient' = CALCULATE(COUNT('encounters'[Id]), ALLEXCEPT('patients', 'patients'[Id]))
		lineageTag: e7eedf94-df31-4182-ac63-4542eefb8121

