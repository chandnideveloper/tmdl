table 'Metric Selector'

    column 'Value'
        formatString: General
        summarizeBy: none
        isNameInferred
        sourceColumn: 'Metric Selector'[Value]
        annotation SummarizationSetBy = Automatic

    partition 'Metric Selector' = calculated
        mode: import
        source = DATATABLE("Value", STRING, {{"Visits"}, {"Patients"}, {"Procedures"}})

    measure 'SelectedMetricSelector'
        expression: SELECTEDVALUE('Metric Selector'[Value], "Visits")
        formatString: General
        isHidden: true

    measure 'Selected Metric' =
        VAR _Metric = SELECTEDVALUE('Metric Selector'[Value])
        RETURN
        SWITCH(
            _Metric,
            "Visits", COUNT('encounters'[Id]),
            "Patients", DISTINCTCOUNT('patients'[Id (patients)1]),
            "Procedures", COUNT('procedures'[CODE (procedures)]),
            BLANK()
        )

    annotation PBI_Id = 09198423876f4b2b84b7665d8393a3a0
    