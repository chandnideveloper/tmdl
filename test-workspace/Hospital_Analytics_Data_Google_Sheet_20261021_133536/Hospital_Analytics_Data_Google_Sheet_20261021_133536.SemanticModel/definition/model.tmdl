model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_b4061a27-1c0c-4487-94f0-fdd81eb59450'
ref table 'LocalDateTable_bf836780-d1c4-473b-8e00-7ad7bd243495'

ref cultureInfo en-US

relationship e3a89de3-da07-4074-8d10-95da7362dbb3
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship d2a8b27f-b6c3-4ec3-9257-9b19c5d220b0
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship cc0b0e82-dd0d-4db5-8786-a77eaf37f05e
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship c0b6dd40-af1d-4fa5-b580-ac5c0ce5ec0b
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 8c1b9243-91f6-45bd-8b33-9bbb73c727a7
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_b4061a27-1c0c-4487-94f0-fdd81eb59450'.'Date'
    joinOnDateBehavior: datePartOnly

relationship a4cf4ea4-3479-45ec-88fe-93f81537525f
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_bf836780-d1c4-473b-8e00-7ad7bd243495'.'Date'
    joinOnDateBehavior: datePartOnly
