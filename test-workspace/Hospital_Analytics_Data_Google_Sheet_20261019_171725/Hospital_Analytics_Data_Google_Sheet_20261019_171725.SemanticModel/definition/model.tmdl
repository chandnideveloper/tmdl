model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_c57c849d-a7bb-403e-b4e1-f2cd382e07f2'
ref table 'LocalDateTable_30cf67c2-9f48-433e-97b4-8a8c350d9fea'

ref cultureInfo en-US

relationship 71497683-d849-40c8-8f13-68e72d41914a
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship 5cbf0717-ab6a-4034-96af-38df4e931528
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship ba8ec9a7-c8c0-4eb0-be31-3e42826edcf4
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship b5f9e8aa-69be-4e25-8b84-a0baa57f61db
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 730e66ce-cc5f-4167-97e5-156e3ae901de
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_c57c849d-a7bb-403e-b4e1-f2cd382e07f2'.'Date'
    joinOnDateBehavior: datePartOnly

relationship fa1c4a82-df5a-4367-9af6-e1549eaf04bd
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_30cf67c2-9f48-433e-97b4-8a8c350d9fea'.'Date'
    joinOnDateBehavior: datePartOnly
