    column 'Encounter Start Date' = DATEVALUE(LEFT('encounters'[Start],10))
        dataType: dateTime
        formatString: Long Date
        lineageTag: 32cdce47-2fa7-459e-a2a7-8f3563ff71d7
        summarizeBy: none

        variation Variation
            isDefault
            relationship: ee41360e-1481-4a73-8b23-cc3cfbe17938
            defaultHierarchy: LocalDateTable_e0fc5864-f96c-41d7-9a31-96c75a73f1cd.'Date Hierarchy'

        changedProperty = DataType

        annotation UnderlyingDateTimeDataType = Date

    measure 'Patient Visits Rank (Top N Patients)' =
        RANKX(ALL('YourTable'), CALCULATE(SUM('YourTable'[Visits per Patient])), , DESC, DENSE)


    measure 'Procedure Rank(Top N Procedure Parameter)' =
        RANKX(ALL('Procedures'), CALCULATE(COUNT('Procedures'[CODE (procedures)])), , DESC, DENSE)


    measure 'Top N Procedures Filter' =
        [Procedure Rank] <= SELECTEDVALUE('Parameters'[Top N Procedures])


    measure 'Visits % Contribution (LOD)' =
        DIVIDE(COUNT('Table'[Id]), CALCULATE(SUM('Table'[Total Visits (LOD)]), ALL('Table')))


    measure 'CNT of Id' =
        COUNT('encounters'[Id])


    measure 'Total Visits' =
        COUNT('encounters'[Id])


    measure 'SUM of Visits per Patient' =
        SUM('encounters'[Visits per Patient])


    measure 'SUM of Base Encounter Cost' =
        SUM('encounters'[Base Encounter Cost])


    measure 'Total Procedures (LOD)' =
        CALCULATE(COUNT('encounters'[Code]), REMOVEFILTERS('encounters'))


    measure 'Total Visits (LOD)' =
        CALCULATE(COUNT('encounters'[Id]), REMOVEFILTERS('encounters'))


    measure 'Visits per Patient' =
        CALCULATE(COUNT('encounters'[Id]), ALLEXCEPT('patients', 'patients'[Id (patients)]))


