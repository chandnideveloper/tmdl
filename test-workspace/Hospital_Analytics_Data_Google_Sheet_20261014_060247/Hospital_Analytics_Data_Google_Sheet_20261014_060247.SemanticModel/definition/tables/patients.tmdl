table patients
	lineageTag: d28f94f3-fba7-5965-91e8-64c9b5840cc3

	measure 'Total Patients (LOD)' = CALCULATE(DISTINCTCOUNT('patients'[Id]), ALL('patients'))
		lineageTag: 94a19edc-2d60-5cef-8dfc-48371b0e6c60

	measure 'Avg Visits per Patient' = CALCULATE(AVERAGE('patients'[Gender]), ALLEXCEPT("patients", 'patients'[Gender]))
		lineageTag: 3e0d065b-0015-5f64-bc38-bdb11547515b

