table 'Metric Selector'

    column 'Value'
        formatString: General
        summarizeBy: none
        isNameInferred
        sourceColumn: 'Metric Selector'[Value]
        annotation SummarizationSetBy = Automatic

    partition 'Metric Selector' = calculated
        mode: import
        source = DATATABLE("Value", STRING, {{"Visits"}, {"Patients"}, {"Procedures"}})

    measure 'SelectedMetricSelector' = SELECTEDVALUE('Metric Selector'[Value], "Visits")
        formatString: General
        isHidden

    measure 'Selected Metric' =
        VAR _Metric = SELECTEDVALUE('Metric Selector'[Value])
        RETURN
        SWITCH(
            TRUE(),
            _Metric = "Visits", COUNTROWS('procedures'),
            _Metric = "Patients", DISTINCTCOUNT('patients'[Id (patients)]),
            _Metric = "Procedures", COUNT('procedures'[CODE (procedures)]),
            BLANK()
        )

    annotation PBI_Id = 1092caeb3fe6433bb7e5ab2b08c4a77f
    