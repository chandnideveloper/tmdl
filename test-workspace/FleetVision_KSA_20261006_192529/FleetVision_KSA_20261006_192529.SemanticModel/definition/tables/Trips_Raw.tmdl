	partition Trips_Raw = m
		mode: import
		source =
				let
				    Source = Sql.Database("server.database.windows.net", "FLEETVISION_KSA"),
				    Result = Value.NativeQuery(Source, "SELECT * FROM fleetvision.trips")
				in
