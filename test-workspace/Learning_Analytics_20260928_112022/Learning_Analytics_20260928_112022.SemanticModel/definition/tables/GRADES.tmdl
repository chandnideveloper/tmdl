table GRADES
	lineageTag: 277a1a66-f2c1-535c-b7c6-27a44fccbe8c

	measure 'Total Enrollments' = COUNT('GRADES'[ENROLLMENT_ID])
		lineageTag: ec6d7f73-9e34-535e-b331-5ee9fa1808d1

	measure 'Average Grade Point' = AVERAGEX('GRADES', SWITCH(TRUE(), 'GRADES'[GRADE] = "A", 5, 'GRADES'[GRADE] = "B", 4, 'GRADES'[GRADE] = "C", 3, 'GRADES'[GRADE] = "D", 2, 'GRADES'[GRADE] = "F", 0, BLANK()))
		lineageTag: b9692873-f903-5494-9325-fb3ef7a8ca4c

	measure 'Decayed GPA Quality Index' =
			VAR MaxDate = CALCULATE(MAX('GRADES'[GRADED_DATE]), ALL('GRADES'))
			VAR WindowGrades =
			FILTER(
			'GRADES',
			'GRADES'[GRADED_DATE] >= MaxDate - 179
			&& 'GRADES'[GRADED_DATE] <= MaxDate
			)
			VAR WindowRowCount = COUNTROWS(WindowGrades)
			VAR DecayedNumerator =
			SUMX(
			WindowGrades,
			VAR GradeVal = 'GRADES'[GRADE]
			VAR NumericGrade = IFERROR(VALUE(GradeVal), BLANK())
			VAR GradePt =
			IF(
			NOT(ISBLANK(NumericGrade)),
			SWITCH(
			TRUE(),
			NumericGrade >= 90, 4.0,
			NumericGrade >= 85, 3.7 + (NumericGrade - 85) * 0.06,
			NumericGrade >= 75, 3.0 + (NumericGrade - 75) * 0.07,
			NumericGrade >= 65, 2.0 + (NumericGrade - 65) * 0.10,
			NumericGrade >= 50, 1.0 + (NumericGrade - 50) * 0.0667,
			0.0
			),
			SWITCH(
			UPPER(TRIM(GradeVal)),
			"A+", 4.0, "A", 4.0, "A-", 3.7,
			"B+", 3.3, "B", 3.0, "B-", 2.7,
			"C+", 2.3, "C", 2.0, "C-", 1.7,
			"D+", 1.3, "D", 1.0, "D-", 0.7,
			"F", 0.0,
			"HD", 4.0, "DI", 3.7, "CR", 2.5,
			"P", 1.0, "N", 0.0,
			"PASS", 1.0, "FAIL", 0.0,
			0.0
			)
			)
			VAR DaysDiff = DATEDIFF('GRADES'[GRADED_DATE], MaxDate, DAY)
			VAR DecayWeight = EXP(-0.6931471805599453 * DaysDiff / 30)
			RETURN DecayWeight * GradePt
			)
			VAR DecayedDenominator =
			SUMX(
			WindowGrades,
			VAR DaysDiff = DATEDIFF('GRADES'[GRADED_DATE], MaxDate, DAY)
			RETURN EXP(-0.6931471805599453 * DaysDiff / 30)
			)
			VAR GuardedDenominator = MAX(1e-9, DecayedDenominator)
			VAR WindowedGPA = DIVIDE(DecayedNumerator, GuardedDenominator)
			VAR AllTimeNumerator =
			SUMX(
			'GRADES',
			VAR GradeVal = 'GRADES'[GRADE]
			VAR NumericGrade = IFERROR(VALUE(GradeVal), BLANK())
			RETURN
			IF(
			NOT(ISBLANK(NumericGrade)),
			SWITCH(
			TRUE(),
			NumericGrade >= 90, 4.0,
			NumericGrade >= 85, 3.7 + (NumericGrade - 85) * 0.06,
			NumericGrade >= 75, 3.0 + (NumericGrade - 75) * 0.07,
			NumericGrade >= 65, 2.0 + (NumericGrade - 65) * 0.10,
			NumericGrade >= 50, 1.0 + (NumericGrade - 50) * 0.0667,
			0.0
			),
			SWITCH(
			UPPER(TRIM(GradeVal)),
			"A+", 4.0, "A", 4.0, "A-", 3.7,
			"B+", 3.3, "B", 3.0, "B-", 2.7,
			"C+", 2.3, "C", 2.0, "C-", 1.7,
			"D+", 1.3, "D", 1.0, "D-", 0.7,
			"F", 0.0,
			"HD", 4.0, "DI", 3.7, "CR", 2.5,
			"P", 1.0, "N", 0.0,
			"PASS", 1.0, "FAIL", 0.0,
			0.0
			)
			)
			)
			VAR AllTimeCount = MAX(1, COUNTROWS('GRADES'))
			VAR AllTimeGPA = DIVIDE(AllTimeNumerator, AllTimeCount)
			RETURN
			25 * IF(WindowRowCount > 0, WindowedGPA, AllTimeGPA)
		lineageTag: 01e7dc9d-e669-513e-a53b-4d39466e2a3e

	measure 'GPA (4.0 scale) average' = AVERAGEX('GRADES', SWITCH(TRUE(), UPPER(TRIM('GRADES'[GRADE])) = "A+", 4.0, UPPER(TRIM('GRADES'[GRADE])) = "A", 4.0, UPPER(TRIM('GRADES'[GRADE])) = "A-", 3.7, UPPER(TRIM('GRADES'[GRADE])) = "B+", 3.3, UPPER(TRIM('GRADES'[GRADE])) = "B", 3.0, UPPER(TRIM('GRADES'[GRADE])) = "B-", 2.7, UPPER(TRIM('GRADES'[GRADE])) = "C+", 2.3, UPPER(TRIM('GRADES'[GRADE])) = "C", 2.0, UPPER(TRIM('GRADES'[GRADE])) = "C-", 1.7, UPPER(TRIM('GRADES'[GRADE])) = "D+", 1.3, UPPER(TRIM('GRADES'[GRADE])) = "D", 1.0, UPPER(TRIM('GRADES'[GRADE])) = "D-", 0.7, UPPER(TRIM('GRADES'[GRADE])) = "F", 0.0, BLANK()))
		lineageTag: 19110caf-88aa-5293-abb9-0d16883074c8

	measure 'Count of Grade' = COUNT('GRADES'[GRADE])
		lineageTag: 033ada9b-007a-592a-a0d1-6d67742cc0fd

	column 'Score based Grade' = 'GRADES'[GRADE]
		dataType: string
		lineageTag: 89d872ff-084e-5465-bd54-d46f44d552b2
		summarizeBy: none

