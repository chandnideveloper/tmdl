model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_88e7d23b-d2da-4cf1-a47d-9d77d4bb243d'
ref table 'LocalDateTable_834a51db-43e4-4b6d-ba44-976ca4d313d1'

ref cultureInfo en-US

relationship aa625997-19fc-416d-b4e7-02b6697c4ae6
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship 66157cd0-cbd9-4102-a1c5-01f8378641dc
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship 9cc1156a-6a29-4125-9f6e-639d56265053
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship 6d9b5b7a-c5a8-4af6-9940-4883fb61dd5d
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 5eb7b9a4-1170-4313-b424-88aecc1ed615
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_88e7d23b-d2da-4cf1-a47d-9d77d4bb243d'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 7afe7b47-c939-42f1-b5cc-d1967281b183
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_834a51db-43e4-4b6d-ba44-976ca4d313d1'.'Date'
    joinOnDateBehavior: datePartOnly
