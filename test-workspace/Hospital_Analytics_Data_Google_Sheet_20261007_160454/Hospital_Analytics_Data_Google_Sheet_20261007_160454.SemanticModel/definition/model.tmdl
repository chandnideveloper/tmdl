model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'encounters'
ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_0f8f213c-968d-4ad7-a686-e3ecfc4a4dc9'
ref table 'LocalDateTable_dc590a25-e1bb-41f6-8615-0b8990704d60'
ref table 'LocalDateTable_4c6bd2c4-91bd-47e5-baac-a07b95329c82'

ref cultureInfo en-US

relationship d90e8fd7-1e37-49d6-a167-faea7e77c900
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id (organizations)'
    crossFilteringBehavior: bothDirections

relationship 068012e3-3d5d-413e-8429-1cade689f203
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id (patients)'
    crossFilteringBehavior: bothDirections

relationship 171252d7-7f77-4109-abe7-3ea89612f02f
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id (payers)'
    crossFilteringBehavior: bothDirections

relationship 3ef155f5-4a6a-4909-ac35-76026b55c713
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship e9ed738b-9003-4714-8b47-620b9180ea85
    fromColumn: 'encounters'.'Encounter Start Date'
    toColumn: 'LocalDateTable_0f8f213c-968d-4ad7-a686-e3ecfc4a4dc9'.'Date'
    joinOnDateBehavior: datePartOnly

relationship da63241c-1c38-43c9-91f9-d948492a6fe3
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_dc590a25-e1bb-41f6-8615-0b8990704d60'.'Date'
