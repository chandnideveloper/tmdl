    measure 'Patient Visits Rank (Top N Patients)' =
        RANKX(ALLSELECTED('patients'), [Visits per Patient], BLANK(), DESC, DENSE)


    measure 'SUM of Avg Visits per Patient (patients)' =
        SUM('patients'[Avg Visits per Patient])


