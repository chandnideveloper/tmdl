table organizations
	lineageTag: ba060f14-9f89-4180-a57e-33455f109465

	measure 'Visits % Contribution (LOD)' = DIVIDE(DISTINCTCOUNT('organizations'[Id]), [Total Visits (LOD)], 0)
		lineageTag: 88a02041-ba3c-4c5d-bbf9-852719e7d74e

	measure 'Total Patients (LOD)' = CALCULATE(DISTINCTCOUNT('patients'[Id]), ALL('patients'))
		lineageTag: a1e5f264-37dd-4856-91b3-72c562230db6

	measure 'Total Procedures (LOD)' = CALCULATE(COUNT('encounters'[Code]), ALL('encounters'))
		lineageTag: 35ee7a17-5ef3-481e-89b3-ae13609568e7

	measure 'Total Visits (LOD)' = CALCULATE(COUNT('organizations'[Id]), ALL('organizations'))
		lineageTag: 33d4d0d9-51f0-4055-a418-a8eb1ad328c4

	measure 'Visits per Patient' = CALCULATE(COUNT('organizations'[Id]), ALLEXCEPT('patients', 'patients'[Id]))
		lineageTag: b767bf08-b6f0-48fc-9512-214be243f4be

	measure 'Avg Visits per Patient' = CALCULATE(AVERAGEX(VALUES('patients'[Id]), [Visits per Patient]), ALLEXCEPT('patients', 'patients'[Gender]))
		lineageTag: c04560df-2fa8-4b8b-874e-589d79fcd87c

	measure 'SUM of Visits per Patient' = SUM('organizations'[Visits per Patient])
		lineageTag: 60dd327d-9b73-4952-8d57-8b32f1865fe5

	measure 'RLS - Organization Access' = IF(USERNAME() = "akash020102@gmail.com", TRUE(), 'organizations'[Name] = "MASSACHUSETTS GENERAL HOSPITAL")
		lineageTag: d4961300-7bd7-4245-a247-a04ab34d267e

