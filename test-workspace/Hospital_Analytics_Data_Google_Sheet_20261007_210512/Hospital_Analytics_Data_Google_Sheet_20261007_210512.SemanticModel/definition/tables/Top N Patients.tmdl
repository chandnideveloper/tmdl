table 'Top N Patients'

    column 'Value'
        formatString: 0
        summarizeBy: sum
        isNameInferred
        sourceColumn: 'Top N Patients'[Value]
        annotation SummarizationSetBy = Automatic

    partition 'Top N Patients' = calculated
        mode: import
        source = GENERATESERIES(1, 1381, 1)

    measure 'SelectedTopNPatients'
        expression: SELECTEDVALUE('Top N Patients'[Value], 29)
        formatString: 0
        isHidden: true

    measure 'Top N Patients' =
        IF([Patient Visits Rank (Top N Patients)] <= INT(SELECTEDVALUE('Top N Patients'[Value])), 1, 0)

    annotation PBI_Id = 85112f40ecf74bc38bf2a80d2e1ff8e5
    