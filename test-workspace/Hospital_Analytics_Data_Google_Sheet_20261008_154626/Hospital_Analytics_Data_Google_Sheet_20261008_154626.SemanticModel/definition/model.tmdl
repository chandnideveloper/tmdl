model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'encounters'
ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_a6254f69-a699-4eda-b0f7-f281a22aa387'
ref table 'LocalDateTable_9bcfae3b-e6ad-41cd-8bef-0b2107f53ac7'
ref table 'LocalDateTable_592ba5e6-f5fd-4c86-9890-2fd891a4cff3'

ref cultureInfo en-US

relationship f5b8aa33-d823-41b9-8ad2-e1f6411f9917
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id (organizations)'
    crossFilteringBehavior: bothDirections

relationship 7a0a7793-2bfe-4734-897a-0c32ff1b35c4
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id (patients)'
    crossFilteringBehavior: bothDirections

relationship 386d2137-2551-4752-8968-38059acd69d5
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id (payers)'
    crossFilteringBehavior: bothDirections

relationship e6bbe977-4f4a-4314-b984-e922fbbe0cfd
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 0050d9fa-99b0-427d-af80-635d25f25d20
    fromColumn: 'encounters'.'Encounter Start Date'
    toColumn: 'LocalDateTable_a6254f69-a699-4eda-b0f7-f281a22aa387'.'Date'
    joinOnDateBehavior: datePartOnly

relationship eb769d77-a710-4e55-9a33-b690ed33472f
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_9bcfae3b-e6ad-41cd-8bef-0b2107f53ac7'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 07b554aa-0e02-4d2d-8271-184600b5c228
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_592ba5e6-f5fd-4c86-9890-2fd891a4cff3'.'Date'
    joinOnDateBehavior: datePartOnly
