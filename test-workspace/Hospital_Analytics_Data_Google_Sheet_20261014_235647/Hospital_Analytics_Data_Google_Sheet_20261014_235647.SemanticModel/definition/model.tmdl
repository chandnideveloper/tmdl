model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_66663d08-d30b-4dee-9b59-146130a89d2e'
ref table 'LocalDateTable_72389618-4ad4-4b6f-8e87-b0737a89b228'
ref table 'LocalDateTable_f5802ab4-3958-4358-a236-c0b01988aef1'

ref cultureInfo en-US

relationship 96f253ac-071b-4947-b748-c351d4caea74
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship 4bb81961-00ce-444b-86a5-1c7716935a57
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship b34e2dd4-1c17-49c2-b222-3ce836aafe63
