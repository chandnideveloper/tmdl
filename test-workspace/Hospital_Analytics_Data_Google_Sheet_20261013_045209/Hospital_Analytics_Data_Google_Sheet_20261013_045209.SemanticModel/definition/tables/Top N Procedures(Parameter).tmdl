table 'Top N Procedures(Parameter)'

    column 'Value'
        formatString: 0
        summarizeBy: sum
        isNameInferred
        sourceColumn: 'Top N Procedures(Parameter)'[Value]
        annotation SummarizationSetBy = Automatic

    partition 'Top N Procedures(Parameter)' = calculated
        mode: import
        source = DATATABLE("Value", INTEGER, {{5}, {10}, {20}, {30}, {50}, {9999}})

    measure 'SelectedTopNProcedures(Parameter)' = SELECTEDVALUE('Top N Procedures(Parameter)'[Value], 10)
        formatString: 0
        isHidden

    measure 'Top N Procedures Filter' =
        IF([Procedure Rank(Top N Procedure Parameter)] <= SELECTEDVALUE('Top N Procedures(Parameter)'[Value]), 1, 0)

    annotation PBI_Id = d4996f0e3dd04d20bad7fe1231e87926
    