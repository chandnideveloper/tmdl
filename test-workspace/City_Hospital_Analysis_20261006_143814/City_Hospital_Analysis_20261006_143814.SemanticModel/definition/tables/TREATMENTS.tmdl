table TREATMENTS
	lineageTag: bd05b695-887f-5aa2-9e75-7247eeff339e

	measure 'Avg. Treatment Cost' = AVERAGE('TREATMENTS'[TREATMENT_COST])
		lineageTag: 86bedc76-c0c3-52e1-8b7e-293660a49c11

	measure 'Appointment to Treatment Ratio' = DIVIDE(COUNT('TREATMENTS'[APPOINTMENT_ID]), CALCULATE(COUNT('TREATMENTS'[APPOINTMENT_ID]), 'TREATMENTS'[APPOINTMENT_ID] = "*"), BLANK())
		lineageTag: cc966de2-5a28-554c-a578-5be544870613

