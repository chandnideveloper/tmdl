model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_ff622edb-6f99-48c5-8504-e957a30bd42c'
ref table 'LocalDateTable_9cab2780-0ace-4474-ae5c-0b2b79fc2d71'
ref table 'LocalDateTable_c903b37a-b671-4b56-8a67-f1b9780b5223'

ref cultureInfo en-US

relationship 1a23d3e7-d98c-4264-b67c-4db8e60c07c1
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship ed29b672-1f6b-4f6a-a824-004412ecb5c5
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship 71edc56a-5290-45de-9cae-de215f6c81cf
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship 2a8579f4-c3f8-450c-bfa8-1fed7e6be815
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 64a09af2-4055-4de5-b251-42d033c54141
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_ff622edb-6f99-48c5-8504-e957a30bd42c'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 69fa9631-2ad3-4504-b231-9329a0065623
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_9cab2780-0ace-4474-ae5c-0b2b79fc2d71'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 9124354d-d3e0-426d-b72c-6f0c5d15e4c4
    fromColumn: 'procedures'.'Encounter Start Date'
    toColumn: 'LocalDateTable_c903b37a-b671-4b56-8a67-f1b9780b5223'.'Date'
    joinOnDateBehavior: datePartOnly
