        summarizeBy: none

    column 'Top N Procedures Filter' = "Unmapped"
        dataType: string

        summarizeBy: none

    measure 'Procedure Rank(Top N Procedure Parameter)' =
        RANKX(ALLSELECTED('procedures'[CODE (procedures)]), CALCULATE(COUNT('procedures'[CODE (procedures)])), , DESC, DENSE)


    measure 'Selected Metric' =
        BLANK()


