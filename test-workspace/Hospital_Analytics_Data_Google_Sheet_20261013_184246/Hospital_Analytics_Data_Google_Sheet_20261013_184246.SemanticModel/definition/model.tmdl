model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'encounters'
ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_9a88fe13-e292-4094-8772-cde19fad2ab5'
ref table 'LocalDateTable_9316f9e1-cefa-4af1-abb3-2c19d9ebf689'
ref table 'LocalDateTable_2991c852-5da3-4559-8a3f-9626f84c408d'

ref cultureInfo en-US

relationship d6a6f1db-521c-4814-88eb-fb0e84b14207
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id (organizations)'
    crossFilteringBehavior: bothDirections

relationship 478c997e-79b5-4ffb-894a-14e330852e8e
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id (patients)'
    crossFilteringBehavior: bothDirections

relationship 097abdc6-edcb-4bd4-a530-21dabc68e8ab
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id (payers)'
    crossFilteringBehavior: bothDirections

relationship fb9cf052-f8e5-410f-bb78-58db5b2d3555
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 6027d678-30f1-4de7-95a3-44590cd5b8d5
    fromColumn: 'encounters'.'Encounter Start Date'
    toColumn: 'LocalDateTable_9a88fe13-e292-4094-8772-cde19fad2ab5'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 0c152731-d85e-485b-85f2-53a984deed48
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_9316f9e1-cefa-4af1-abb3-2c19d9ebf689'.'Date'
    joinOnDateBehavior: datePartOnly

relationship f8628c9c-0a15-4204-9ff9-e261e358f409
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_2991c852-5da3-4559-8a3f-9626f84c408d'.'Date'
