relationship 2d4bc682-e8b1-43e7-9112-f34e9bb64f3d
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_6d27e5fa-9c8a-46ee-a617-2c4212a14e34'.'Date'
