table Encounters
	lineageTag: b67417d9-e741-5fd2-955d-37f9b7b45a5f

	measure 'Total Base Encounter Cost' = SUM('Encounters'[BASE_ENCOUNTER_COST])
		lineageTag: a2f9d0b2-2ead-50a2-bce6-8ac714fbe307

	measure 'Total Encounters' = DISTINCTCOUNT('Encounters'[PatientId])
		lineageTag: 637169c5-1af9-5205-86a0-757265b0ec2f

	measure 'Procedures per Encounter' = DIVIDE(Count('Procedures'[CODE]), DISTINCTCOUNT('Encounters'[PatientId]), BLANK())
		lineageTag: 8b617b80-3269-5b19-aabd-611c50810339

	measure 'Total Payer Coverage' = SUM('Encounters'[PAYER_COVERAGE])
		lineageTag: 304c6783-a3d0-5f3e-97db-367ca5f0e73b

	measure 'Average Encounter Cost' = AVERAGE('Encounters'[TOTAL_CLAIM_COST])
		lineageTag: eca171bc-68e2-5ef1-8e84-cc2d67e71f30

	measure 'Total Claim Cost' = SUM('Encounters'[TOTAL_CLAIM_COST])
		lineageTag: 6bb294c3-bbe9-516d-b9af-c23ecfbd04e6

	measure 'Avg Encounter Duration' = AVERAGEX('Encounters', DATEDIFF('Encounters'[START], 'Encounters'[STOP], DAY))
		lineageTag: 7ead582b-bf67-5a56-8319-b556dcbfb2e2

	measure 'Coverage %' = DIVIDE(Sum('Encounters'[PAYER_COVERAGE]), Sum('Encounters'[TOTAL_CLAIM_COST]), BLANK())
		formatString: "0.0%"
		lineageTag: 817a2174-baba-568c-805e-46c820d07b2c

	measure 'High-Cost Encounters' = CALCULATE(DISTINCTCOUNT('Encounters'[PatientId]), 'Encounters'[TOTAL_CLAIM_COST] >= 10000)
		lineageTag: 06b6f7a8-31c8-5c7c-98c6-4e2fbc00730d

	measure 'Cost Contribution %' = DIVIDE(Sum('Encounters'[TOTAL_CLAIM_COST]), CALCULATE(SUM('Encounters'[TOTAL_CLAIM_COST]), ALLSELECTED()), BLANK())
		formatString: "0.0%"
		lineageTag: 8507766b-de50-516b-b701-b815be0b8234

