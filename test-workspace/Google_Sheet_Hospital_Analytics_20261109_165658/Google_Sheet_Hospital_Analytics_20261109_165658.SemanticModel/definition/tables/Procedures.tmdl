table Procedures
	lineageTag: 72883db3-387c-55a5-b945-324703be28b6

	/// TODO (Qlik set analysis {<...>} has no direct DAX equivalent): Convert the Qlik expression to DAX manually.
	/// Original Qlik: Num(  (          Sum('Encounters'[TOTAL_CLAIM_COST]) - Sum( {       <   EncounterYear = { "$(=Max(EncounterYear)-1)"                      }                  >              }
	measure 'YoY Claim Cost Growth' = BLANK()
		lineageTag: 1db74dcc-c437-5165-8122-a8e4ce2b6fb0

	measure 'Total Procedures' = COUNT('Procedures'[CODE])
		lineageTag: 9627a2b1-c921-5617-ac1d-7a868f25a6d1

	measure 'Median Encounter Cost' = Median('Encounters'[TOTAL_CLAIM_COST])
		lineageTag: 8e194b7e-f5a1-5e18-8772-a13490d8af15

	measure 'Patient Out-of-Pocket Cost' =
			(
			Sum('Encounters'[TOTAL_CLAIM_COST])
			-
			Sum('Encounters'[PAYER_COVERAGE])
			) / 1000000
		formatString: "\$#,##0.0\M"
		lineageTag: 936aca92-090b-5c1a-8232-85f4e8b93e6e

	measure 'Total Procedure Cost' = SUM('Procedures'[BASE_COST])
		lineageTag: dd18fef2-3feb-5714-b990-6e2ee7a1117c

	measure 'Total Patients' = DISTINCTCOUNT('Procedures'[PatientId])
		lineageTag: 40132e23-d922-5cd7-ac11-22229adca197

	measure 'Average Patient Age' = AVERAGEX('Patients', DATEDIFF('Patients'[BIRTHDATE], TODAY(), YEAR))
		lineageTag: dd4c9801-4c16-5544-adb0-b1a87ae4c0f7

