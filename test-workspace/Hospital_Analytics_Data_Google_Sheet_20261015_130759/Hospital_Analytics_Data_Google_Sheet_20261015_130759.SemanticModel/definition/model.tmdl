model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_b4577a33-53da-4b50-bceb-0a0ecb684ad5'
ref table 'LocalDateTable_929bfe70-8681-4f27-a5b8-b34621a93a97'
ref table 'LocalDateTable_5c1ff54f-d203-44a9-b46f-118330511717'

ref cultureInfo en-US

relationship ad0bc2ca-a005-4945-9688-f7d59c36c4a8
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship fcda7319-5654-4024-851e-a6758fc785d9
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship 8fe434d6-98e1-4189-84a0-45a52f93ccea
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship 10c308dd-6dcc-475a-ad32-92fe72953b6e
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship ca68c63b-c7fa-4cc2-862f-e7d6d523633a
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_b4577a33-53da-4b50-bceb-0a0ecb684ad5'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 4294142d-d3de-4248-b159-f9e7948d3aed
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_929bfe70-8681-4f27-a5b8-b34621a93a97'.'Date'
