model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_a86c970c-091f-45df-836c-49b3b91499d6'
ref table 'LocalDateTable_89628c19-ecba-43ec-92db-13f0a6b3ef0f'
ref table 'LocalDateTable_f5579d3b-6dce-47bd-a887-d7d4d471570a'

ref cultureInfo en-US

relationship 95c0d737-ee3f-40ef-9334-a9cf055b890d
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship 6cf7e055-fe58-4b5c-b300-0315ad5af723
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship 9ee72963-3b00-45c8-a768-43753b1079f2
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship 9476af3c-a6e9-44cc-af14-32b98a206238
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship e6727d1b-c7da-4d16-aa31-ac3083f78414
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_a86c970c-091f-45df-836c-49b3b91499d6'.'Date'
    joinOnDateBehavior: datePartOnly

relationship ebcd00c0-c2cb-4d7a-bcb2-baf9b7f6bb74
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_89628c19-ecba-43ec-92db-13f0a6b3ef0f'.'Date'
