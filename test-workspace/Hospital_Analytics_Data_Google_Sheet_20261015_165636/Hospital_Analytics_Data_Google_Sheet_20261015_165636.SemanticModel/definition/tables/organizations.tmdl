table 'organizations'
    lineageTag: 2f29b431-9c7f-4cb4-8943-191cb6a55bf3

    column 'Id'
        dataType: string
        lineageTag: 384a4bc6-f0b4-4505-a29e-0ef0011db7ec
        summarizeBy: none
        sourceColumn: Id

    column 'Name'
        dataType: string
        lineageTag: 74641034-e777-4174-b791-5cc253c73dee
        summarizeBy: none
        sourceColumn: Name

    column 'ADDRESS'
        dataType: string
        lineageTag: bc75a5fb-89a1-440a-9dc6-4ac7a25846e6
        summarizeBy: none
        sourceColumn: ADDRESS

    column 'CITY'
        dataType: string
        lineageTag: aab8d747-7e5e-446e-b2b4-2140af468971
        summarizeBy: none
        sourceColumn: CITY

    column 'STATE'
        dataType: string
        lineageTag: a3c8767a-f723-432f-a528-1e815b9deab0
        summarizeBy: none
        sourceColumn: STATE

    column 'ZIP'
        dataType: double
