    column 'LON'
        dataType: double
        lineageTag: 1e134341-8556-49ef-956f-f286f478d6a5
        summarizeBy: none
        sourceColumn: LON

    column 'Username' = 'organizations'[Name]
        dataType: string

        summarizeBy: none

    measure 'Visits % Contribution (LOD)' =
        DIVIDE(DISTINCTCOUNT('organizations'[Id]), CALCULATE([Total Visits (LOD)], ALLSELECTED()), 0)


    measure 'RLS - Organization Access' =
        IF(USERNAME() = "akash020102@gmail.com", TRUE(), 'organizations'[Name] = "MASSACHUSETTS GENERAL HOSPITAL")


    partition 'organizations' = m
        mode: import
        source =
            let Source = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/1Gfqr930PI28eveUiJrS8ikSsyzDUbPE4pJy7nG9ZIUc"),
            #"Navigation 1" = Source{[name = "organizations", ItemKind = "Table"]}[Data],
