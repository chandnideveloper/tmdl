    measure 'Patient Visits Rank (Top N Patients)' =
        RANKX(ALLSELECTED('patients'), [Visits per Patient], , DESC, DENSE)


    measure 'Top N Patients Measure' =
        IF([Patient Visits Rank (Top N Patients)] <= SELECTEDVALUE('Top N Patients'[Value]), 1, 0)


    measure 'Selected Metric' =
        VAR _MetricSelector = SELECTEDVALUE('Metric Selector'[Value])
        RETURN
        SWITCH(
            _MetricSelector,
            "Visits", COUNT('encounters'[Id]),
            "Patients", DISTINCTCOUNT('patients'[Id]),
            "Procedures", COUNT('procedures'[CODE]),
            0
        )


    measure 'Visits % Contribution (LOD)' =
        DIVIDE(COUNT('encounters'[Id]), CALCULATE([Total Visits (LOD)], ALLSELECTED()), 0)


    measure 'Total Patients (LOD)' =
        CALCULATE(DISTINCTCOUNT('patients'[Id]), ALL('patients'))


    measure 'Total Visits (LOD)' =
        CALCULATE(COUNT('encounters'[Id]), ALL('encounters'))


    measure 'Visits per Patient' =
        CALCULATE(COUNT('encounters'[Id]), ALLEXCEPT('patients', 'patients'[Id]))


    measure 'Avg Visits per Patient' =
        CALCULATE(AVERAGEX(VALUES('patients'[Id]), [Visits per Patient]), ALLEXCEPT('patients', 'patients'[Gender]))


    partition 'patients' = m
        mode: import
        source =
            let Source = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/1Sd4bEK0Fm9q7yTVOwI4GdtixeeY8hPkKqpvnI4WdixA"),
