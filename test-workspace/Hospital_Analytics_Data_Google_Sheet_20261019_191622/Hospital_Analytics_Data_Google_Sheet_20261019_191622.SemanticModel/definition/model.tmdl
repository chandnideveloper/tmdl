model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_34d236b7-a979-402e-b4e6-6895886a7995'
ref table 'LocalDateTable_b5b55ea9-975c-4f49-b832-00c5365649d0'

ref cultureInfo en-US

relationship 1c0a6407-45c6-4482-a68c-5bf9df55ed81
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship b5250c2e-0aa3-4e07-84a5-03b9c804a1f2
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship 47016aed-1ad8-4389-b3cf-6d52501fde9a
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship 2a45eedd-d05e-41b2-b644-f8749bd35ab2
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 10a98212-3a63-4f4e-8581-9faa24954c50
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_34d236b7-a979-402e-b4e6-6895886a7995'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 9fe5bbc9-6abf-48ab-bc66-7dfa00237af8
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_b5b55ea9-975c-4f49-b832-00c5365649d0'.'Date'
    joinOnDateBehavior: datePartOnly
