model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_2ed81479-be7c-4c0f-bfb5-62e2f69ee96a'
ref table 'LocalDateTable_72dca787-4b2a-491c-95dc-37cd6ded412b'

ref cultureInfo en-US

relationship 4bf9203e-85d3-46b4-ad9e-5e9b7f6bb01c
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship df92f1ea-1089-46fb-b57b-52beff2fad02
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship 6e912730-8680-4fc7-939c-6632b2e697aa
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship 0a466c6f-8f15-48ba-a8cd-aef3d46b0f38
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 167e0af3-7644-4c3b-bf78-7b90f0003f36
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_2ed81479-be7c-4c0f-bfb5-62e2f69ee96a'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 4c918db3-61d7-4024-a535-f35126810a1d
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_72dca787-4b2a-491c-95dc-37cd6ded412b'.'Date'
    joinOnDateBehavior: datePartOnly
