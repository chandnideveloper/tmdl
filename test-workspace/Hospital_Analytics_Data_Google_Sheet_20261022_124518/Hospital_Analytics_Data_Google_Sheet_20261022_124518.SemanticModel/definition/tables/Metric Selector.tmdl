table 'Metric Selector'

    column 'Value'
        formatString: General
        summarizeBy: none
        isNameInferred
        sourceColumn: 'Metric Selector'[Value]
        annotation SummarizationSetBy = Automatic

    partition 'Metric Selector' = calculated
        mode: import
        source = DATATABLE("Value", STRING, {{"Visits"}, {"Patients"}, {"Procedures"}})

    measure 'SelectedMetricSelector' = SELECTEDVALUE('Metric Selector'[Value], "Visits")
        formatString: General
        isHidden: true

    annotation PBI_Id = 07fab0ba8d81432690b0d54f6518de5d
    