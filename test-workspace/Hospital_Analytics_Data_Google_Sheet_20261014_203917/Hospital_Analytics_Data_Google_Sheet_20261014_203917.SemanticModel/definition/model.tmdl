ref table 'LocalDateTable_897465e3-792b-43c3-af04-c36d9674e0a0'

ref cultureInfo en-US

relationship e03ad5e1-b06a-4116-a3bb-be8efa458564
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship 6492acd9-2736-4368-a94d-a969ab97ba10
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship e6f0b8d2-38df-4b48-8c19-2def7c5bc42c
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship c3f5facf-d8a7-4813-9583-25f5a53ce6ac
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

