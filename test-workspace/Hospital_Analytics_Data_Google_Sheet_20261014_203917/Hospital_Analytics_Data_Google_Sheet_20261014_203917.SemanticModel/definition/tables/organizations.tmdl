table 'organizations'
    lineageTag: 5c7ee731-2994-4b6b-b86b-c56593242878

    column 'Id'
        dataType: string
        lineageTag: 7022988a-278b-4390-9512-2cc61da51764
        summarizeBy: none
        sourceColumn: Id

    column 'Name'
        dataType: string
        lineageTag: f95e9342-2c39-41bb-810c-20ed168b5b46
        summarizeBy: none
        sourceColumn: Name

    column 'ADDRESS'
        dataType: string
        lineageTag: 6c9c21b7-8d72-4e78-897a-896acc3a653d
        summarizeBy: none
        sourceColumn: ADDRESS

    column 'CITY'
        dataType: string
        lineageTag: d07f5fb7-c284-4e82-aedc-bf05eaadb823
        summarizeBy: none
        sourceColumn: CITY

    column 'STATE'
        dataType: string
        lineageTag: 3c5a5765-1daf-49e4-8592-b2b750d0ffdf
        summarizeBy: none
        sourceColumn: STATE

    column 'ZIP'
        dataType: double
        lineageTag: db30ea79-4f54-407b-9e32-fb6c351717a9
        summarizeBy: none
        sourceColumn: ZIP

    column 'LAT'
        dataType: double
        lineageTag: d37cd56e-b9d9-4251-9996-1b065d02c598
        summarizeBy: none
        sourceColumn: LAT

    column 'LON'
        dataType: double
        lineageTag: 2ae98108-6f17-4f02-9935-ebbb634ffd55
        summarizeBy: none
        sourceColumn: LON

    column 'Username' = SELECTEDVALUE('organizations'[Name])
        dataType: string

        summarizeBy: none

    measure 'Visits % Contribution (LOD)' =
        DIVIDE(DISTINCTCOUNT('organizations'[Id]), CALCULATE([Total Visits (LOD)], ALLSELECTED()))


    measure 'Total Patients (LOD)' =
        CALCULATE(DISTINCTCOUNT('patients'[Id]), ALL('patients'))


    measure 'Total Procedures (LOD)' =
        CALCULATE(COUNT('encounters'[Code]), ALL('encounters'))


    measure 'Total Visits (LOD)' =
        CALCULATE(COUNT('organizations'[Id]), ALL('organizations'))


    measure 'Visits per Patient' =
        CALCULATE(COUNT('organizations'[Id]), ALLEXCEPT('patients', 'patients'[Id]))


    measure 'Avg Visits per Patient' =
        CALCULATE(AVERAGE('patients'[Visits per Patient]), ALLEXCEPT('patients', 'patients'[Gender]))


    measure 'SUM of Visits per Patient' =
        SUM('organizations'[Visits per Patient])


    measure 'RLS - Organization Access' =
        IF(USERNAME() = "akash020102@gmail.com", TRUE(), SELECTEDVALUE('organizations'[Name]) = "MASSACHUSETTS GENERAL HOSPITAL")


    partition 'organizations' = m
        mode: import
        source =
            let Source = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/1Gfqr930PI28eveUiJrS8ikSsyzDUbPE4pJy7nG9ZIUc"),
            #"Navigation 1" = Source{[name = "organizations", ItemKind = "Table"]}[Data],
            #"Promoted Headers" = Table.PromoteHeaders(#"Navigation 1", [PromoteAllScalars = true]),
            #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers", {{"NAME", "Name"}}),
            #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns", {{"Id", type text}, {"Name", type text}, {"ADDRESS", type text}, {"CITY", type text}, {"STATE", type text}, {"ZIP", Int64.Type}, {"LAT", type number}, {"LON", type number}}),
            #"Filtered Blank Rows" = Table.SelectRows(#"Changed Type", each [Id] <> null and [Id] <> ""),
                            #"Removed Blank Columns" = Table.SelectColumns(#"Filtered Blank Rows", {"Id", "Name", "ADDRESS", "CITY", "STATE", "ZIP", "LAT", "LON"}, MissingField.Ignore)
                        in
                            #"Removed Blank Columns"
