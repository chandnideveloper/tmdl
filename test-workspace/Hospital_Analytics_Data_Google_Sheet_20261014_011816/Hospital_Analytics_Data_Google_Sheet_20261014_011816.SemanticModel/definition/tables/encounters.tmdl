    measure 'CNT of Id (encounters)' =
        COUNT('encounters'[Id])


    measure 'Total Visits' =
        COUNT('encounters'[Id])


    measure 'SUM of Visits per Patient (encounters)' =
        SUM('encounters'[Visits per Patient])


    measure 'SUM of Base Encounter Cost (encounters)' =
        SUM('encounters'[Base Encounter Cost])


    measure 'Total Visits (LOD)' =
        CALCULATE(COUNT('encounters'[Id]), REMOVEFILTERS('encounters'))


    measure 'Visits per Patient' =
        CALCULATE(COUNT('encounters'[Id]), REMOVEFILTERS('encounters'), ALLEXCEPT('patients', 'patients'[Id]))


