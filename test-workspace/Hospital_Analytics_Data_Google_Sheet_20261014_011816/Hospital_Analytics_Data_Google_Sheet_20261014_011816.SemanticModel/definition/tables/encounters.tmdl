table encounters
	lineageTag: e74e13fc-0ffb-4ac5-bcef-c60e236197c8

	measure 'CNT of Id (encounters)' = COUNT('encounters'[Id])
		lineageTag: f93819a2-aee1-441b-9e07-c18d6df2c739

	measure 'Total Visits' = COUNT('encounters'[Id])
		lineageTag: b0c643a1-c638-4fd7-bc66-ba21de611d46

	measure 'SUM of Visits per Patient (encounters)' = SUM('encounters'[Visits per Patient])
		lineageTag: 9c293e90-fda1-4b6f-9669-5fa461e71643

	measure 'SUM of Base Encounter Cost (encounters)' = SUM('encounters'[Base Encounter Cost])
		lineageTag: 41f2fae4-0aef-4e8f-8e9a-3cc514931919

	measure 'Total Visits (LOD)' = CALCULATE(COUNT('encounters'[Id]), REMOVEFILTERS('encounters'))
		lineageTag: b35d85cd-3100-4fc5-98de-9b09928cdae8

	measure 'Visits per Patient' = CALCULATE(COUNT('encounters'[Id]), REMOVEFILTERS('encounters'), ALLEXCEPT('patients', 'patients'[Id]))
		lineageTag: 28d91e08-1576-450d-9346-88d5c243ec4a

