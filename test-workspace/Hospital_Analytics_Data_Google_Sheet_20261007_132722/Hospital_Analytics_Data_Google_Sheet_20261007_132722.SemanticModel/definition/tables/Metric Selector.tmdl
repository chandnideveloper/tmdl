table 'Metric Selector'
	lineageTag: 126385fd-653f-45ab-95bc-914732cc89ed

	measure SelectedMetricSelector = SELECTEDVALUE('Metric Selector'[Value], "Visits")
		formatString: General
		isHidden
		lineageTag: 0ff44f34-bb7e-456e-b4b2-c8782c8b313c

	measure 'Selected Metric' =
			VAR _Metric = SELECTEDVALUE('Metric Selector'[Value])
			RETURN
			SWITCH(
			    _Metric,
			    "Visits", COUNT('encounters'[Id]),
			    "Patients", DISTINCTCOUNT('patients'[Id (patients)1]),
			    "Procedures", COUNT('procedures'[CODE (procedures)]),
			    BLANK()
			)
		lineageTag: 0b53f8f8-0868-424d-b991-b99e0712fcd1

	column 'Value'
		lineageTag: b4627d9a-9c92-4697-a743-39d6bafe3946
		isNameInferred
		sourceColumn: [Value]

	partition 'Metric Selector' = calculated
		mode: import
		source = DATATABLE("Value", STRING, {{"Visits"}, {"Patients"}, {"Procedures"}})

	annotation PBI_Id = f2b736879cb246df9dd00d4b4f48f1af

