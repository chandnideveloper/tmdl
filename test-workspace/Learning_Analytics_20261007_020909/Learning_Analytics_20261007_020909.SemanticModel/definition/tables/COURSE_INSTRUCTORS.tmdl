				    #"Navigation 2" = #"Navigation 1"{[Name = "PUBLIC", Kind = "Schema"]}[Data],
				    #"Navigation 3" = #"Navigation 2"{[Name = "COURSE_INSTRUCTORS", Kind = "Table"]}[Data]
				in
