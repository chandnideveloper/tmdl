table COURSE_INSTRUCTORS
	lineageTag: 041af670-a044-52d1-aa5e-3a7c03d2a5e5

	measure 'Total Instructors' = COUNT('COURSE_INSTRUCTORS'[INSTRUCTOR_ID])
		lineageTag: fd5ad14c-45fe-5d40-ae55-0cd2a7163579

	measure 'Assignment Duration' = AVERAGEX('COURSE_INSTRUCTORS', TODAY() - 'COURSE_INSTRUCTORS'[ASSIGNED_DATE])
		lineageTag: 22a4b98e-6311-5d9e-9001-8ee5cb903705

	measure 'Rolling 12-month assignments' =
			VAR MaxDate = CALCULATE(MAX('COURSE_INSTRUCTORS'[ASSIGNED_DATE]), ALL('COURSE_INSTRUCTORS'))
			VAR StartDate = EDATE(DATE(YEAR(MaxDate), MONTH(MaxDate), 1), -11)
			VAR EndDate = EOMONTH(MaxDate, 0)
			RETURN
			CALCULATE(
			COUNTROWS('COURSE_INSTRUCTORS'),
			'COURSE_INSTRUCTORS'[ASSIGNED_DATE] >= StartDate
			&& 'COURSE_INSTRUCTORS'[ASSIGNED_DATE] <= EndDate
			)
		lineageTag: 088d1460-22c9-5ca7-94d3-dffceeafe409

	column COURSE_ID
		dataType: string
		lineageTag: 134eb7c3-a7c4-55ce-9612-c8ba2e0196e2
		summarizeBy: none
		sourceColumn: COURSE_ID

		annotation SummarizationSetBy = Automatic

	column INSTRUCTOR_ID
		dataType: string
		lineageTag: 52c3a779-396a-585e-acad-f852d49465a3
		summarizeBy: none
		sourceColumn: INSTRUCTOR_ID

		annotation SummarizationSetBy = Automatic

	column ASSIGNED_DATE
		dataType: dateTime
		formatString: Long Date
		lineageTag: f23691ee-c9a4-5c26-bea2-8c1fbf3a0e98
		summarizeBy: none
		sourceColumn: ASSIGNED_DATE

		variation Variation
			isDefault
			relationship: ab7dc68f-009e-420a-a759-110408e41022
			defaultHierarchy: LocalDateTable_60eaf536-8e18-40cf-9b70-c9bf67257442.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

