    column 'Reasondescription'
        dataType: string
        lineageTag: 478d2426-434a-4895-b660-762726274061
        summarizeBy: none
        sourceColumn: Reasondescription

    column 'Patient Visits Rank (Top N Patients)' = "Unmapped"
        dataType: string

        summarizeBy: none

    column 'Encounter Start Date' = "Unmapped"
        dataType: string

        summarizeBy: none

    measure 'Top N Patients' =
        IF([Patient Visits Rank (Top N Patients)] <= [Top N Patients], 1, 0)


    measure 'Visits % Contribution (LOD)' =
        DIVIDE(DISTINCTCOUNT('encounters'[Id]), SUMX(VALUES('encounters'[Id]), [Total Visits (LOD)]))


    measure 'CNT of Id' =
        COUNT('encounters'[Id])


    measure 'Total Visits' =
        COUNT('encounters'[Id])


    measure 'SUM of Base Encounter Cost' =
        SUM('encounters'[Base Encounter Cost])


    measure 'Top N Patients' =
        BLANK()


    measure 'Visits % Contribution (LOD)' =
        BLANK()


    partition 'encounters' = m
        mode: import
        source =
            let Source = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/1UFffx5ngb7j1Y2kqRzPCPVA0uvA88GLaftek_fwOjKY"),
            #"Navigation 1" = Source{[name = "encounters", ItemKind = "Table"]}[Data],
                            #"Final Renamed Columns" = Table.RenameColumns(#"Navigation 1", {{"START", "Start"}, {"STOP", "Stop"}, {"PATIENT", "Patient"}, {"ORGANIZATION", "Organization"}, {"PAYER", "Payer"}, {"ENCOUNTERCLASS", "Encounterclass"}, {"CODE", "Code"}, {"DESCRIPTION", "Description"}, {"BASE_ENCOUNTER_COST", "Base Encounter Cost"}, {"TOTAL_CLAIM_COST", "Total Claim Cost"}, {"PAYER_COVERAGE", "Payer Coverage"}, {"REASONCODE", "Reasoncode"}, {"REASONDESCRIPTION", "Reasondescription"}}, MissingField.Ignore)
                        in
                            #"Final Renamed Columns"
