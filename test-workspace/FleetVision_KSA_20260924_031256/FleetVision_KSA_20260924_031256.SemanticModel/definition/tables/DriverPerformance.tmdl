		lineageTag: 98b2f4a1-e0d8-5320-a2f7-3c5b586a27fc
		summarizeBy: sum
		formatString: #,##0.00

		annotation SummarizationSetBy = Automatic

	column FleetMPG = DIVIDE(CALCULATE(SUM('Trips'[actual_distance_miles])), CALCULATE(SUM('Trips'[fuel_gallons_used])), 0)
		dataType: double
		lineageTag: 4f766b95-c033-58ce-8574-cc99405efda3
