table DriverPerformance
	lineageTag: 45e4a570-977d-56a3-ba43-7e841ee0690b

	column driver_id
		dataType: string
		lineageTag: 423ac404-8093-56ae-a1ae-3fd51b27ce71
		summarizeBy: none
		sourceColumn: driver_id

		annotation SummarizationSetBy = Automatic

	column TotalTrips = CALCULATE(DISTINCTCOUNT('Trips'[trip_id]))
		dataType: double
		lineageTag: 71074d0a-12be-5155-a402-d5c8f7494d29
		summarizeBy: sum
		formatString: ###0

		annotation SummarizationSetBy = Automatic

	column TotalMiles = CALCULATE(SUM('Trips'[actual_distance_miles]))
		dataType: double
		lineageTag: ee2aca6e-5705-5d9f-b343-dfaec87438e1
		summarizeBy: sum
		formatString: #,##0

		annotation SummarizationSetBy = Automatic

	column TotalTripHours = CALCULATE(SUM('Trips'[actual_duration_hours]))
		dataType: double
		lineageTag: d02e9eb5-9a8d-5eb1-9a1f-a41656414bda
		summarizeBy: sum
		formatString: #,##0.00

		annotation SummarizationSetBy = Automatic

	column TotalFuelGallons = CALCULATE(SUM('Trips'[fuel_gallons_used]))
