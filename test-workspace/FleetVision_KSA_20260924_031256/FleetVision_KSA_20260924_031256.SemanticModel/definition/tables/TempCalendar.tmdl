table TempCalendar
	lineageTag: 5e0cd0f0-e0ba-57de-8846-e7ae4705b534

	column MinDate = CALCULATE(MIN('Trips'[DispatchDate]))
		dataType: dateTime
		lineageTag: 684b2574-4b39-53f6-93bb-0271715bf31f
		summarizeBy: none
		formatString: General Date

		annotation SummarizationSetBy = Automatic

	column MaxDate = CALCULATE(MAX('Trips'[DispatchDate]))
		dataType: dateTime
		lineageTag: 22d091f3-9138-5e68-8cdf-d6b4c35c21f3
		summarizeBy: none
		formatString: General Date

		annotation SummarizationSetBy = Automatic

	partition TempCalendar = m
		mode: import
		source =
				let
				    Source = Trips,
				    MinDate = List.Min(Source[DispatchDate]),
				    MaxDate = List.Max(Source[DispatchDate]),
				    Result = #table(type table [MinDate = date, MaxDate = date], {{MinDate, MaxDate}})
				in
				    Result

	annotation PBI_ResultType = Table
