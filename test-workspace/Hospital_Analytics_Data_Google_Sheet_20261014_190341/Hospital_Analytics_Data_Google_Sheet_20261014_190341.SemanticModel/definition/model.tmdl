model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_b51e3de0-0490-4982-b9a2-5c7776b19d0d'
ref table 'LocalDateTable_f510ecb8-a081-4bfe-af92-6ab533ad9bf8'
ref table 'LocalDateTable_ca493b07-10ba-4133-b51f-595798639dfe'

ref cultureInfo en-US

relationship a36df5d9-8c42-49fc-abe1-3bdeee4a2964
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship 34b50b2b-ee30-4036-ae3c-7a85f4d27eef
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship c78eb9cf-7be4-4fb3-be2d-782c293900bf
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship 4579c0af-8403-4c9d-af44-2a63f6a69627
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 361e22da-29a2-47b6-97d7-ed791c9399ea
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_b51e3de0-0490-4982-b9a2-5c7776b19d0d'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 17e793d1-df21-4c06-9662-ed63a1fd620a
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_f510ecb8-a081-4bfe-af92-6ab533ad9bf8'.'Date'
    joinOnDateBehavior: datePartOnly

relationship b00dd77a-7f49-4965-aef6-e3f4c4fc1650
    fromColumn: 'procedures'.'Encounter Start Date'
    toColumn: 'LocalDateTable_ca493b07-10ba-4133-b51f-595798639dfe'.'Date'
