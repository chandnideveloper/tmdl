ref table 'LocalDateTable_6c817580-00ea-4bb1-a431-a261a1fe5b7b'

ref cultureInfo en-US

relationship fda0274a-7f0f-4ab5-922d-a21bcdb62698
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship 66e577e6-4284-426e-9229-20dd3f5c23ca
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship b5aa99f3-63f1-4d5e-91d1-bec3ab6cf386
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

