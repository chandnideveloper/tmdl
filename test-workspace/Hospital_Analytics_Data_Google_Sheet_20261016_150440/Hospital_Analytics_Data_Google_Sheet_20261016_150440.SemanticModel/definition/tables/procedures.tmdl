    column 'Encounter'
        dataType: string
        lineageTag: 47e40bae-8030-46ab-a599-9bc52e95731e
        summarizeBy: none
        sourceColumn: Encounter

    column 'CODE'
        dataType: double
        lineageTag: 76e9f76d-1266-4ecc-b059-900a4b36c5eb
        summarizeBy: none
        sourceColumn: CODE

    column 'DESCRIPTION'
        dataType: string
        lineageTag: 12c47d11-918d-4c61-90e4-5dbd8eb10db0
        summarizeBy: none
        sourceColumn: DESCRIPTION

    column 'Base Cost'
        dataType: double
        lineageTag: 39fb8187-5e07-4f11-936d-177b39b7dbb9
        summarizeBy: none
        sourceColumn: Base Cost

    column 'REASONCODE'
        dataType: double
        lineageTag: 41e37c79-c3e5-4790-bb6b-b83d4286398d
        summarizeBy: none
        sourceColumn: REASONCODE

    column 'REASONDESCRIPTION'
        dataType: string
        lineageTag: cadb7083-61dd-484b-91e8-74ae194fac07
        summarizeBy: none
        sourceColumn: REASONDESCRIPTION

    column 'DESCRIPTION__procedures__Set_Category' =
        IF('procedures'[DESCRIPTION] IN { "Admission to burn unit", "Admission to long stay hospital", "Admission to orthopedic department", "Admission to trauma surgery department", "Ankle X-ray", "Antenatal RhD antibody screening", "Assessment of health and social care needs (procedure)" }, "In", "Out")
        dataType: string
        summarizeBy: none

    column 'DESCRIPTION__procedures__Set_Category_In_Out' =
        'procedures'[DESCRIPTION__procedures__Set_Category]
        dataType: string
        summarizeBy: none

    column 'DESCRIPTION__procedures__Set_In_Out' =
        'procedures'[DESCRIPTION__procedures__Set_Category]
        dataType: string
        summarizeBy: none

    column 'DESCRIPTION__procedures__Set' =
        'procedures'[DESCRIPTION__procedures__Set_Category]
        dataType: string
        summarizeBy: none

    measure 'Procedure Rank(Top N Procedure Parameter)' =
        RANKX(ALLSELECTED('procedures'[CODE]), CALCULATE(COUNTROWS('procedures'), 'procedures'[CODE] = EARLIER('procedures'[CODE])), BLANK(), DESC, DENSE)


    measure 'Top N Procedures Filter' =
        'Procedures'[Procedure Rank] <= SELECTEDVALUE('Top N Procedures(Parameter)'[Value])


    measure 'Total Procedures (LOD)' =
        CALCULATE(COUNT('procedures'[CODE]), ALL('procedures'))


    measure 'Total Procedures' =
        COUNT('procedures'[CODE])


    measure 'Procedures Measure' =
        COUNT('procedures'[CODE])


    partition 'procedures' = m
        mode: import
        source =
            let Source = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/10X1xQHkGidpz_0qYh7o9mxmsRJsOHRB9bNnSKFnUNgo"),
            #"Navigation 1" = Source{[name = "procedures", ItemKind = "Table"]}[Data],
            #"Promoted Headers" = Table.PromoteHeaders(#"Navigation 1", [PromoteAllScalars = true]),
            #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers", {{"ENCOUNTER", "Encounter"}, {"BASE_COST", "Base Cost"}}),
            #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns", {{"START", type text}, {"STOP", type text}, {"PATIENT", type text}, {"Encounter", type text}, {"CODE", Int64.Type}, {"DESCRIPTION", type text}, {"Base Cost", Int64.Type}, {"REASONCODE", Int64.Type}, {"REASONDESCRIPTION", type text}}),
            #"Filtered Blank Rows" = Table.SelectRows(#"Changed Type", each [CODE] <> null and [CODE] <> ""),
                            #"Removed Blank Columns" = Table.SelectColumns(#"Filtered Blank Rows", {"START", "STOP", "PATIENT", "Encounter", "CODE", "DESCRIPTION", "Base Cost", "REASONCODE", "REASONDESCRIPTION", "DESCRIPTION__procedures__Set_Category", "DESCRIPTION__procedures__Set_Category_In_Out", "DESCRIPTION__procedures__Set_In_Out", "DESCRIPTION__procedures__Set"}, MissingField.Ignore)
                        in
                            #"Removed Blank Columns"
