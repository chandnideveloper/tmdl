        lineageTag: f086049a-67c2-48e1-97e4-b6e234c338ad
        summarizeBy: none
        sourceColumn: Reasondescription

    column 'Encounter Start Date' =
        DATEVALUE('encounters'[Start])
        dataType: string
        summarizeBy: none

    measure 'Patient Visits Rank (Top N Patients)' =
        RANKX(ALLSELECTED('patients'[Last]), [Visits per Patient], BLANK(), DESC, DENSE)


    measure 'Top N Patients Measure' =
        BLANK()


    measure 'Visits % Contribution (LOD)' =
        BLANK()


    measure 'Total Visits (LOD)' =
        CALCULATE(COUNT('encounters'[Id]), ALL('encounters'))


    measure 'Visits per Patient' =
        CALCULATE(COUNT('encounters'[Id]), ALLEXCEPT('patients', 'patients'[Id]))


    measure 'COUNT of Id (encounters)' =
        COUNT('encounters'[Id])


    measure 'Total Visits' =
        COUNT('encounters'[Id])


    measure 'SUM of Base Encounter Cost (encounters)' =
        SUM('encounters'[Base Encounter Cost])


    partition 'encounters' = m
        mode: import
        source =
            let Source = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/1UFffx5ngb7j1Y2kqRzPCPVA0uvA88GLaftek_fwOjKY"),
