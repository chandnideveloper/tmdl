table Trips
	lineageTag: 3b0e1031-f748-5307-97a6-2f8653b800cd

	measure 'Maximum Trips by Truck' = MAXX(VALUES('Trucks'[truck_id]), CALCULATE(COUNT('Trips'[trip_id])))
		lineageTag: 8dbb9c27-3953-55a5-b794-ee73660ad1b0

	measure 'Fleet Operations' = MAXX(VALUES('Trucks'[truck_id]), CALCULATE(COUNT('Trips'[trip_id])))
