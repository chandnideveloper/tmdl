        sourceColumn: Name

    column 'ADDRESS'
        dataType: string
        lineageTag: fc2a093a-7134-49ee-8b5f-48e1db69b351
        summarizeBy: none
        sourceColumn: ADDRESS

    column 'CITY'
        dataType: string
        lineageTag: 43fce38d-3f0f-422d-9621-1a2c314dc6d3
