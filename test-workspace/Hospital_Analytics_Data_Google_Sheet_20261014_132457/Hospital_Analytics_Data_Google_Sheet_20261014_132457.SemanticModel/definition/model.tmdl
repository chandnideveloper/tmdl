model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_cede834e-cee3-40ea-96fc-ae95208e9bf5'
ref table 'LocalDateTable_9f7d8cd4-b2fe-4942-afee-ca50ff941942'
ref table 'LocalDateTable_c7de8519-343b-4efa-9464-8ac912ca68d6'

ref cultureInfo en-US

relationship 8dd9ef8c-2f4e-44a3-b0bc-ccb83739ac28
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship 9f0556c5-a0e9-401f-a357-e9cda6b5d077
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship 34609237-5e90-4cd4-9f58-db739ec5299d
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship eb701038-063c-4474-90bc-28d631f7b021
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 9568f831-e181-41f8-abe9-01b1f87d3380
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_cede834e-cee3-40ea-96fc-ae95208e9bf5'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 14e4e2d3-4c68-4010-bc97-e18b6fd05434
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_9f7d8cd4-b2fe-4942-afee-ca50ff941942'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 43314e77-143e-481c-933c-2e9280d15408
