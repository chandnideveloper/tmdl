    column 'Encounter'
        dataType: string
        lineageTag: 70332998-5a95-43aa-85f2-e7af2891bf4b
        summarizeBy: none
        sourceColumn: Encounter

    column 'CODE'
        dataType: double
        lineageTag: 6ac6d679-26a3-41cc-94a1-d582aed37c63
