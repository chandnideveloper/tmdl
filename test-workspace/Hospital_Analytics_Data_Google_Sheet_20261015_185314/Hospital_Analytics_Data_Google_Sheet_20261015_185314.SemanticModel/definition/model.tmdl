model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_20c591c2-0a51-4ec5-a6b3-7a23ab97bbcc'
ref table 'LocalDateTable_4663f8bb-8c59-4216-9426-6d0e8c23a3cf'
ref table 'LocalDateTable_7ae9614c-be36-4c15-b265-59659629eb9e'

ref cultureInfo en-US

relationship 18982c48-9b06-4de6-8e0b-4e928f5a740f
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship e0e56e3b-deb1-4357-aa17-c4233f12a9d8
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship fd773784-669a-4498-a47c-49251e40202a
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship 2d875851-1354-4392-91ae-228e8be419b6
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 0841088a-af2b-4c7f-bb48-8d442eeaea45
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_20c591c2-0a51-4ec5-a6b3-7a23ab97bbcc'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 006bdb38-d357-4de5-8d4a-2e5dd19da326
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_4663f8bb-8c59-4216-9426-6d0e8c23a3cf'.'Date'
    joinOnDateBehavior: datePartOnly

relationship 8b3b72e6-1a52-4fa6-8403-fe7b4b5bf52c
    fromColumn: 'encounters'.'Encounter Start Date'
    toColumn: 'LocalDateTable_7ae9614c-be36-4c15-b265-59659629eb9e'.'Date'
