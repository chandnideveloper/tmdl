    column 'ZIP'
        dataType: double
        lineageTag: 02e8230a-f276-4429-8434-7c01930a4805
        summarizeBy: none
        sourceColumn: ZIP

    column 'LAT'
        dataType: double
        lineageTag: 4da6f809-401e-410a-a3c2-3e68e99f43b9
        summarizeBy: none
        sourceColumn: LAT

    column 'LON'
        dataType: double
        lineageTag: 4de36caa-a278-4602-b0e3-c905764d3fc5
        summarizeBy: none
        sourceColumn: LON

    column 'Username' = SELECTEDVALUE('organizations'[Name])
        dataType: string

        summarizeBy: none

    measure 'Visits % Contribution (LOD)' =
        BLANK()


    measure 'Total Patients (LOD)' =
        CALCULATE(DISTINCTCOUNT('patients'[Id]), ALL('patients'))


    measure 'Total Procedures (LOD)' =
        CALCULATE(COUNT('encounters'[Code]), ALL('encounters'))


    measure 'Total Visits (LOD)' =
        CALCULATE(COUNT('organizations'[Id]), ALL('organizations'))


    measure 'Visits per Patient' =
        CALCULATE(COUNT('organizations'[Id]), ALLEXCEPT('patients', 'patients'[Id]))


    measure 'Avg Visits per Patient' =
        CALCULATE(AVERAGE('patients'[Visits per Patient]), ALLEXCEPT('patients', 'patients'[Gender]))


    measure 'SUM of Visits per Patient' =
        SUM('organizations'[Visits per Patient])


    measure 'RLS - Organization Access' =
        -- ERROR: LLM call failed after 6 retries. Last error: 413 Client Error: Payload Too Large for url: https://api.groq.com/openai/v1/chat/completions


