table organizations
	lineageTag: 0faa2de5-f97d-4aaf-a7b9-395a7bfa9e83

	measure 'Visits % Contribution (LOD)' = BLANK()
		lineageTag: 08c3faa4-17e2-408d-a3fc-d04643b76546

	measure 'Total Patients (LOD)' = CALCULATE(DISTINCTCOUNT('patients'[Id]), ALL('patients'))
		lineageTag: 376dd0fb-71a2-4fc7-bda7-4876cfbf6084

	measure 'Total Procedures (LOD)' = CALCULATE(COUNT('encounters'[Code]), ALL('encounters'))
		lineageTag: c7929956-1a35-4822-974e-88545d1113a6

	measure 'Total Visits (LOD)' = CALCULATE(COUNT('organizations'[Id]), ALL('organizations'))
		lineageTag: e7a904dd-2915-4b5e-a54d-3d3bf13ff88b

	measure 'Visits per Patient' = CALCULATE(COUNT('organizations'[Id]), ALLEXCEPT('patients', 'patients'[Id]))
		lineageTag: a98621dd-3076-4fe7-8094-2eaf26a360b2

	measure 'Avg Visits per Patient - Test 2' =
			
			DIVIDE(
			    COUNTROWS('encounters'),
			    DISTINCTCOUNT('encounters'[Patient])
			)
		lineageTag: a06fb542-7ddb-42ca-8998-b1b4b06c784f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SUM of Visits per Patient' = SUM('organizations'[Visits per Patient])
		lineageTag: eb05e09d-0baf-463a-a8a4-52a14891ffc5

	measure 'RLS - Organization Access' = -- ERROR: LLM call failed after 6 retries. Last error: 413 Client Error: Payload Too Large for url: https://api.groq.com/openai/v1/chat/completions
		lineageTag: a9f060d2-5d2a-4518-82b1-02926f148af1

