table COURSES
	lineageTag: aef0d33b-71a4-5d33-acdb-9c8f236a6bb5

	measure 'Average Credits' = AVERAGE('COURSES'[CREDITS])
		formatString: "#,##0.00"
		lineageTag: 6423b155-78fd-5c68-816d-d2a029603e99

	measure 'Total Courses' = DISTINCTCOUNT('COURSES'[COURSE_ID])
		formatString: "#,##0.00"
		lineageTag: c3d88ac9-c95e-50d1-b772-ad5b195a12a3

	column 'Course Category' = 'COURSES'[CREDITS]
		dataType: double
		lineageTag: 1c5ce9f4-58e9-5d7c-a1b1-7267dec4e135
		summarizeBy: none

	column COURSE_ID
		dataType: string
		lineageTag: b20ab871-1f63-54a3-968d-512304647cc6
		summarizeBy: none
		sourceColumn: COURSE_ID

		annotation SummarizationSetBy = Automatic

	column COURSE_NAME
