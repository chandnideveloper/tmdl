table 'Select Metric'

    column 'Value'
        formatString: General
        summarizeBy: none
        isNameInferred
        sourceColumn: 'Select Metric'[Value]
        annotation SummarizationSetBy = Automatic

    partition 'Select Metric' = calculated
        mode: import
        source = DATATABLE("Value", STRING, {{"Total Loans"}, {"Total Amount"}, {"Avg Loan"}})

    measure 'SelectedSelectMetric' = SELECTEDVALUE('Select Metric'[Value], "Total Loans")
        formatString: General
        isHidden: true

    annotation PBI_Id = a3c2c21ec93f434fa6fca03ec456cea9
    