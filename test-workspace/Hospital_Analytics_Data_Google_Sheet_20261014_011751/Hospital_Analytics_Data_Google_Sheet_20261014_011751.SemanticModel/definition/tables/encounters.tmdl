    measure 'Top N Patients' =
        -- ERROR: LLM call failed after 6 retries. Last error: 429 rate limit on attempt 6


    measure 'Visits % Contribution (LOD)' =
        DIVIDE(COUNT('encounters'[Id]), SUMX(VALUES('encounters'[Id]), [Total Visits (LOD)]), 0)


    measure 'CNT of Id' =
        COUNT('encounters'[Id])


    measure 'Total Visits' =
        COUNT('encounters'[Id])


    measure 'SUM of Base Encounter Cost' =
        SUM('encounters'[Base Encounter Cost])


