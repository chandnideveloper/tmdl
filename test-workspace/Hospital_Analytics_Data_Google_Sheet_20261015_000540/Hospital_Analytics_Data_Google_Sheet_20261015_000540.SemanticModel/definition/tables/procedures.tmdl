    column 'DESCRIPTION__procedures__Set_Category' = IF('procedures'[DESCRIPTION] IN { "Admission to burn unit", "Admission to long stay hospital", "Admission to orthopedic department", "Admission to trauma surgery department", "Ankle X-ray", "Antenatal RhD antibody screening", "Assessment of health and social care needs (procedure)" }, "In", "Out")
        dataType: string

        summarizeBy: none

    column 'Encounter Start Date' = DATEVALUE(LEFT('procedures'[START],10))
        dataType: dateTime
        formatString: Long Date
        lineageTag: 36f8c2ac-d164-4a9b-b78c-4255aa203aba
        summarizeBy: none

        variation Variation
            isDefault
            relationship: b9be1767-0de4-4b1f-84d2-6ace630baf90
            defaultHierarchy: LocalDateTable_4550ecdd-540b-4482-9279-5afabc73bef8.'Date Hierarchy'

        changedProperty = DataType

        annotation UnderlyingDateTimeDataType = Date

    measure 'Top N Patients Measure' =
        [Patient Visits Rank (Top N Patients)] <= SELECTEDVALUE('Top N Patients'[Value])


    measure 'Procedure Rank(Top N Procedure Parameter)' =
        RANKX(ALLSELECTED('procedures'[CODE]), CALCULATE(COUNT('procedures'[CODE])), BLANK(), DESC, DENSE)


    measure 'Total Procedures' =
        COUNT('procedures'[CODE])


    measure 'Procedures Measure' =
        COUNT('procedures'[CODE])


    partition 'procedures' = m
        mode: import
        source =
            let Source = GoogleSheets.Contents("https://docs.google.com/spreadsheets/d/10X1xQHkGidpz_0qYh7o9mxmsRJsOHRB9bNnSKFnUNgo"),
            #"Navigation 1" = Source{[name = "procedures", ItemKind = "Table"]}[Data],
