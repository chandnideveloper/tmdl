model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
        legacyRedirects
        returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1
annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table 'organizations'
ref table 'patients'
ref table 'payers'
ref table 'procedures'
ref table 'encounters'
ref table 'Top N Procedures(Parameter)'
ref table 'Metric Selector'
ref table 'Top N Patients'
ref table 'LocalDateTable_cefc3ba3-47c7-4a09-9606-67ad57334b72'
ref table 'LocalDateTable_bad0b0bc-f5d0-4130-a40a-b81b89de6a87'
ref table 'LocalDateTable_4550ecdd-540b-4482-9279-5afabc73bef8'

ref cultureInfo en-US

relationship 16952dbb-6b69-4a7e-8809-6086f9cc30d0
    fromColumn: 'encounters'.'Organization'
    toColumn: 'organizations'.'Id'
    crossFilteringBehavior: bothDirections

relationship fceb1279-c064-4d8c-b53f-c1878780da4b
    fromColumn: 'encounters'.'Patient'
    toColumn: 'patients'.'Id'
    crossFilteringBehavior: bothDirections

relationship 2c913f2c-16fa-45bd-867e-633a8b7c8d0f
    fromColumn: 'encounters'.'Payer'
    toColumn: 'payers'.'Id'
    crossFilteringBehavior: bothDirections

relationship 445ea81a-b3ae-4ec5-aebc-e53f02d05510
    fromColumn: 'procedures'.'Encounter'
    toColumn: 'encounters'.'Id'
    crossFilteringBehavior: bothDirections

relationship 524ef456-1fa7-4a24-bb8b-9250d26abe10
    fromColumn: 'patients'.'Birthdate'
    toColumn: 'LocalDateTable_cefc3ba3-47c7-4a09-9606-67ad57334b72'.'Date'
    joinOnDateBehavior: datePartOnly

relationship a9176a68-5c21-4f67-980a-1a27cbf0fcfb
    fromColumn: 'patients'.'Deathdate'
    toColumn: 'LocalDateTable_bad0b0bc-f5d0-4130-a40a-b81b89de6a87'.'Date'
    joinOnDateBehavior: datePartOnly

relationship b9be1767-0de4-4b1f-84d2-6ace630baf90
    fromColumn: 'procedures'.'Encounter Start Date'
    toColumn: 'LocalDateTable_4550ecdd-540b-4482-9279-5afabc73bef8'.'Date'
    joinOnDateBehavior: datePartOnly
